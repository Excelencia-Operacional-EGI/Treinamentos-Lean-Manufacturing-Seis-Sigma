  fb.className = 'quiz-feedback'; fb.innerHTML = '';

  var btn = document.getElementById('quiz-next-btn');
  btn.className = 'quiz-btn';
  btn.textContent = qIndex === tot - 1 ? 'Ver Resultado →' : 'Próxima →';

  var optsEl = document.getElementById('quiz-options');
  optsEl.innerHTML = '';
  var letters = ['A','B','C','D'];
  q.opts.forEach(function(opt, i){
    var b = document.createElement('button');
    b.className = 'quiz-opt';
    b.innerHTML = '<span class="opt-letter">' + letters[i] + '</span><span class="opt-text">' + opt + '</span>';
    b.onclick = function(){ selectAnswer(i); };
    optsEl.appendChild(b);
  });

  answered = false;
}

function selectAnswer(idx){
  if(answered) return;
  answered = true;
  var q    = QUESTIONS[qIndex];
  var opts = document.querySelectorAll('.quiz-opt');
  var fb   = document.getElementById('quiz-feedback');
  var btn  = document.getElementById('quiz-next-btn');

  opts.forEach(function(o){ o.disabled = true; });

  catTotal[q.cat]++;
  if(idx === q.correct){
    opts[idx].classList.add('correct');
    fb.className = 'quiz-feedback fb-correct show';
    fb.innerHTML = q.fb_ok;
    score++;
    catScore[q.cat]++;
  } else {
    opts[idx].classList.add('wrong');
    opts[q.correct].classList.add('reveal');
    fb.className = 'quiz-feedback fb-wrong show';
    fb.innerHTML = q.fb_err;
  }

  btn.className = 'quiz-btn visible';
}

function nextQuestion(){
  qIndex++;
  if(qIndex < QUESTIONS.length){
    renderQuestion();
  } else {
    showResult();
  }
}

function showResult(){
  document.getElementById('quiz-progress-wrap').style.display = 'none';
  document.getElementById('quiz-card').style.display          = 'none';

  var res = RESULTS.find(function(r){ return score >= r.min && score <= r.max; });
  var pct = Math.round((score / QUESTIONS.length) * 100);

  document.getElementById('result-emoji').textContent      = res.emoji;
  document.getElementById('result-stars').textContent      = res.stars;
  document.getElementById('result-score-num').textContent  = score + '/' + QUESTIONS.length;
  document.getElementById('result-title').textContent      = res.title;
  document.getElementById('result-msg').innerHTML          = res.msg;

  // category bars
  ['conceito','aplicacao','atitude'].forEach(function(cat){
    var cPct = catTotal[cat] > 0 ? Math.round((catScore[cat] / catTotal[cat]) * 100) : 0;
    var labels = { conceito:'Conceito', aplicacao:'Aplicação', atitude:'Atitude' };
    document.getElementById('bar-' + cat).style.width = cPct + '%';
    document.getElementById('val-' + cat).textContent = catScore[cat] + '/' + catTotal[cat];
  });

  var resultEl = document.getElementById('quiz-result');
  resultEl.className = 'quiz-result show';

  // animated conic ring
  setTimeout(function(){
    var badge = document.getElementById('result-badge');
    badge.style.setProperty('--pct', pct + '%');
  }, 300);
}

function restartQuiz(){
  qIndex   = 0;
  score    = 0;
  answered = false;
  catScore = { conceito: 0, aplicacao: 0, atitude: 0 };
  catTotal = { conceito: 0, aplicacao: 0, atitude: 0 };

  document.getElementById('quiz-result').className           = 'quiz-result';
  document.getElementById('quiz-progress-wrap').style.display = '';
  document.getElementById('quiz-card').style.display          = '';

  // reset bars
  ['conceito','aplicacao','atitude'].forEach(function(cat){
    document.getElementById('bar-' + cat).style.width = '0%';
    document.getElementById('val-' + cat).textContent = '—';
  });

  renderQuestion();
}

// Boot
renderQuestion();
</script>
</body>
</html>
