<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SMED – Guia de Auto Treinamento | Biolab & Co.</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,700;1,300&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
<style>
:root {
  --navy:      #0B1F3A;
  --navy-mid:  #122848;
  --navy-lite: #1C3A5F;
  --blue:      #1A6FD4;
  --blue-lt:   #E8F2FF;
  --teal:      #00C2B2;
  --teal-lt:   #E0FAF8;
  --green:     #0DBD74;
  --green-lt:  #E6FAF3;
  --red:       #E03A3A;
  --red-lt:    #FDF0F0;
  --amber:     #F59E0B;
  --amber-lt:  #FFF8E6;
  --white:     #FFFFFF;
  --off-white: #F5F8FF;
  --gray-100:  #EDF1F8;
  --gray-200:  #DDE4EF;
  --gray-400:  #94A3B8;
  --gray-600:  #4B5E79;
  --text:      #1A2A40;
  --r:         14px;
  --r-lg:      20px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;background:var(--gray-100);color:var(--text);-webkit-font-smoothing:antialiased;}
.page{max-width:680px;margin:0 auto;}
section{padding:48px 28px;position:relative;}
.s-light{background:var(--white);}
.s-off{background:var(--off-white);}

/* LABELS & TITLES */
.section-label{font-size:10px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--blue);margin-bottom:6px;display:flex;align-items:center;gap:8px;}
.section-label::before{content:'';width:14px;height:2px;background:var(--blue);border-radius:2px;}
.section-label.teal{color:var(--teal);}.section-label.teal::before{background:var(--teal);}
.section-title{font-family:'DM Serif Display',serif;font-size:clamp(1.6rem,5.5vw,2rem);line-height:1.2;color:var(--navy);margin-bottom:14px;}
.section-body{font-size:15px;line-height:1.75;color:var(--gray-600);}

/* BADGE */
.badge{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.22);color:#A8D0FF;font-size:10px;font-weight:700;letter-spacing:2.2px;text-transform:uppercase;padding:6px 14px;border-radius:40px;}
.badge::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--teal);display:inline-block;animation:pulse-dot 2s ease-in-out infinite;}
@keyframes pulse-dot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.5;transform:scale(1.4);}}

/* HERO */
.hero{background:linear-gradient(155deg,var(--navy) 0%,var(--navy-mid) 55%,var(--navy-lite) 100%);color:var(--white);padding:56px 28px 44px;overflow:hidden;position:relative;}
.hero::before{content:'';position:absolute;top:-80px;right:-80px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(26,111,212,0.25) 0%,transparent 70%);pointer-events:none;}
.hero::after{content:'';position:absolute;bottom:-60px;left:-40px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(0,194,178,0.12) 0%,transparent 70%);pointer-events:none;}
.hero-inner{position:relative;z-index:1;}
.hero-title{font-family:'DM Serif Display',serif;font-size:clamp(2.6rem,8vw,3.6rem);line-height:1.08;margin:20px 0 14px;letter-spacing:-1px;}
.hero-title span{color:var(--teal);}
.hero-sub{font-size:15px;color:rgba(255,255,255,0.72);line-height:1.65;max-width:440px;margin-bottom:36px;}
.hero-sub strong{color:var(--white);font-weight:600;}
.hero-divider{height:1px;background:linear-gradient(90deg,rgba(255,255,255,0.18) 0%,transparent 100%);margin:0 0 20px;}
.hero-footer{font-size:11px;color:rgba(255,255,255,0.42);letter-spacing:1.2px;text-transform:uppercase;display:flex;align-items:center;gap:10px;}
.hero-footer::before{content:'';width:22px;height:1px;background:var(--teal);flex-shrink:0;}
.brand-pill{display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.14);border-radius:8px;padding:10px 16px;margin-top:28px;}
.brand-dot{width:8px;height:8px;border-radius:50%;background:var(--teal);flex-shrink:0;}
.brand-name{font-size:13px;font-weight:600;color:var(--white);}
.brand-tag{font-size:10px;color:rgba(255,255,255,0.45);letter-spacing:1px;text-transform:uppercase;}

/* QUOTE */
.quote-box{margin-top:28px;padding:20px 22px;border-left:3px solid var(--teal);background:linear-gradient(135deg,#EFF9FF 0%,#F0FFFC 100%);border-radius:0 var(--r) var(--r) 0;position:relative;}
.quote-box::before{content:'"';font-family:'DM Serif Display',serif;font-size:5rem;color:var(--teal);opacity:.2;position:absolute;top:-10px;left:10px;line-height:1;pointer-events:none;}
.quote-box p{font-style:italic;font-size:14.5px;line-height:1.7;color:var(--navy);font-weight:500;position:relative;z-index:1;}

/* STATS */
.stats-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px;}
.stat-pill{flex:1;min-width:130px;border-radius:var(--r);padding:16px 14px;text-align:center;background:var(--white);box-shadow:0 2px 12px rgba(11,31,58,0.07);border-top:3px solid var(--blue);}
.stat-pill.teal-top{border-top-color:var(--teal);}
.stat-pill.green-top{border-top-color:var(--green);}
.stat-num{font-family:'DM Serif Display',serif;font-size:1.9rem;color:var(--navy);line-height:1;margin-bottom:4px;}
.stat-lbl{font-size:12px;color:var(--gray-600);line-height:1.4;}

/* CARDS */
.cards-grid{display:flex;flex-direction:column;gap:16px;margin-top:28px;}
.card{border-radius:var(--r);padding:20px 20px 20px 22px;border-left:4px solid transparent;background:var(--white);box-shadow:0 2px 14px rgba(11,31,58,0.07);display:flex;gap:16px;align-items:flex-start;transition:transform .2s,box-shadow .2s;}
.card:hover{transform:translateX(4px);box-shadow:0 6px 24px rgba(11,31,58,0.12);}
.card.blue{border-left-color:var(--blue);}.card.teal{border-left-color:var(--teal);}.card.green{border-left-color:var(--green);}.card.amber{border-left-color:var(--amber);}
.card-icon{font-size:1.9rem;flex-shrink:0;margin-top:2px;}
.card-body h4{font-size:14.5px;font-weight:700;color:var(--navy);margin-bottom:5px;line-height:1.3;}
.card-body p{font-size:13.5px;color:var(--gray-600);line-height:1.65;}

/* GRADE DE TIPOS */
.setup-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:28px;}
@media(max-width:460px){.setup-grid{grid-template-columns:1fr;}}
.setup-card{border-radius:var(--r-lg);padding:22px 18px;position:relative;overflow:hidden;}
.setup-card::before{content:'';position:absolute;top:-30px;right:-30px;width:100px;height:100px;border-radius:50%;opacity:.15;}
.setup-card.green-card{background:var(--green-lt);border:1.5px solid #B2EDDA;}
.setup-card.green-card::before{background:var(--green);}
.setup-card.red-card{background:var(--red-lt);border:1.5px solid #F5C6C6;}
.setup-card.red-card::before{background:var(--red);}
.setup-tag{display:inline-flex;align-items:center;gap:5px;font-size:9.5px;font-weight:800;letter-spacing:1.8px;text-transform:uppercase;padding:4px 10px;border-radius:30px;margin-bottom:12px;}
.green-card .setup-tag{background:var(--green);color:var(--white);}
.red-card .setup-tag{background:var(--red);color:var(--white);}
.setup-card h3{font-family:'DM Serif Display',serif;font-size:1.2rem;color:var(--navy);margin-bottom:8px;line-height:1.2;}
.setup-card p{font-size:13px;color:var(--gray-600);line-height:1.65;}
.setup-card .highlight-note{margin-top:12px;font-size:12px;font-weight:700;color:var(--red);background:rgba(224,58,58,0.08);border-radius:6px;padding:7px 10px;}
.setup-card.green-card .highlight-note{color:#0A9A5F;background:rgba(13,189,116,0.10);}
.machine-status{display:flex;align-items:center;gap:6px;margin-bottom:12px;}
.status-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.green-dot{background:var(--green);box-shadow:0 0 6px var(--green);animation:pulse-dot 2s infinite;}
.red-dot{background:var(--red);box-shadow:0 0 6px var(--red);}
.status-label{font-size:11px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;}
.green-card .status-label{color:var(--green);}
.red-card .status-label{color:var(--red);}

/* BEFORE / AFTER */
.ba-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:28px;}
@media(max-width:420px){.ba-grid{grid-template-columns:1fr;}}
.ba-card{border-radius:var(--r-lg);padding:20px 18px;}
.ba-card.before{background:var(--red-lt);border:1.5px solid #F5C6C6;}
.ba-card.after{background:var(--green-lt);border:1.5px solid #B2EDDA;}
.ba-header{display:flex;align-items:center;gap:8px;margin-bottom:14px;font-size:11px;font-weight:800;letter-spacing:1.6px;text-transform:uppercase;}
.ba-card.before .ba-header{color:var(--red);}
.ba-card.after .ba-header{color:#0A9A5F;}
.ba-items{display:flex;flex-direction:column;gap:8px;}
.ba-item{font-size:13px;color:var(--gray-600);line-height:1.5;display:flex;gap:8px;}

/* ANALOGIES */
.analogy-list{display:flex;flex-direction:column;gap:14px;margin-top:26px;}
.analogy-item{display:flex;gap:16px;align-items:flex-start;background:var(--white);border-radius:var(--r);padding:18px;box-shadow:0 2px 12px rgba(11,31,58,0.06);border:1px solid rgba(26,111,212,0.08);transition:transform .18s;}
.analogy-item:hover{transform:translateY(-3px);}
.analogy-emoji{font-size:2rem;flex-shrink:0;}
.analogy-text h4{font-size:14px;font-weight:700;color:var(--navy);margin-bottom:4px;}
.analogy-text p{font-size:13.5px;color:var(--gray-600);line-height:1.6;}
.analogy-text p em{color:var(--blue);font-style:normal;font-weight:600;}

/* LISTA DE VERIFICAÇÃO / RADAR */
.checklist{display:flex;flex-direction:column;gap:10px;margin-top:22px;}
.check-item{display:flex;gap:12px;align-items:flex-start;background:var(--white);border:1.5px solid var(--gray-200);border-radius:var(--r);padding:14px 16px;cursor:pointer;transition:border-color .18s,background .18s;}
.check-item:hover{border-color:var(--blue);background:var(--blue-lt);}
.check-item.checked{border-color:var(--green);background:var(--green-lt);}
.check-box{width:22px;height:22px;border-radius:6px;border:2px solid var(--gray-400);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:.9rem;transition:all .18s;margin-top:1px;background:var(--white);color:transparent;}
.check-item.checked .check-box{background:var(--green);border-color:var(--green);color:var(--white);}
.check-text{font-size:13.5px;color:var(--gray-600);line-height:1.6;}
.check-text strong{color:var(--navy);}
.radar-score{margin-top:20px;padding:16px 20px;background:linear-gradient(135deg,var(--navy) 0%,var(--navy-lite) 100%);border-radius:var(--r-lg);color:var(--white);display:flex;align-items:center;gap:14px;}
.score-icon{font-size:2rem;flex-shrink:0;}
.score-label{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:rgba(255,255,255,.5);margin-bottom:3px;}
.score-value{font-family:'DM Serif Display',serif;font-size:1.3rem;}
.score-bar{margin-top:8px;height:6px;background:rgba(255,255,255,0.15);border-radius:3px;overflow:hidden;}
.score-fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--blue));border-radius:3px;transition:width .4s ease;width:0%;}

/* TIMELINE */
.timeline{position:relative;margin-top:32px;padding-left:14px;}
.timeline::before{content:'';position:absolute;left:27px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,var(--blue) 0%,var(--teal) 100%);border-radius:2px;}
.t-step{display:flex;gap:20px;align-items:flex-start;margin-bottom:28px;position:relative;}
.t-step:last-child{margin-bottom:0;}
.t-num{width:42px;height:42px;border-radius:50%;background:var(--navy);color:var(--white);font-family:'DM Serif Display',serif;font-size:1.1rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;position:relative;z-index:1;box-shadow:0 0 0 4px var(--off-white),0 0 0 6px rgba(26,111,212,0.18);transition:background .2s,box-shadow .2s;}
.t-step:hover .t-num{background:var(--blue);box-shadow:0 0 0 4px var(--off-white),0 0 0 6px rgba(26,111,212,0.35);}
.t-content{flex:1;background:var(--white);border-radius:var(--r);padding:16px 18px;box-shadow:0 2px 12px rgba(11,31,58,0.07);border:1px solid rgba(26,111,212,0.07);}
.t-content h4{font-size:14.5px;font-weight:700;color:var(--navy);margin-bottom:5px;}
.t-content p{font-size:13.5px;color:var(--gray-600);line-height:1.65;}
.t-content p em{color:var(--blue);font-style:normal;font-weight:600;}
.t-tips{margin-top:12px;display:flex;flex-direction:column;gap:6px;}
.t-tip{display:flex;align-items:flex-start;gap:8px;font-size:13px;color:var(--gray-600);line-height:1.5;}
.t-tip::before{content:'→';color:var(--teal);font-weight:700;flex-shrink:0;margin-top:1px;}

/* QUICK WINS */
.qw-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:24px;}
@media(max-width:440px){.qw-grid{grid-template-columns:1fr;}}
.qw-card{border-radius:var(--r);padding:16px;background:var(--white);border:1px solid var(--gray-200);box-shadow:0 2px 10px rgba(11,31,58,0.05);transition:transform .18s,box-shadow .18s;}
.qw-card:hover{transform:translateY(-4px);box-shadow:0 8px 22px rgba(11,31,58,0.1);}
.qw-icon{font-size:1.6rem;margin-bottom:8px;}
.qw-card h4{font-size:13.5px;font-weight:700;color:var(--navy);margin-bottom:5px;}
.qw-card p{font-size:12.5px;color:var(--gray-600);line-height:1.6;}
.qw-tag{margin-top:10px;display:inline-block;font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:3px 9px;border-radius:20px;}
.qw-tag.ext{background:var(--green-lt);color:#0A9A5F;}
.qw-tag.int{background:var(--red-lt);color:var(--red);}
.qw-tag.std{background:var(--blue-lt);color:var(--blue);}

/* ERRORS */
.errors-list{display:flex;flex-direction:column;gap:12px;margin-top:24px;}
.error-item{display:flex;gap:14px;align-items:flex-start;border-radius:var(--r);padding:16px 18px;background:var(--white);border-left:4px solid var(--amber);box-shadow:0 2px 10px rgba(11,31,58,0.06);}
.error-icon{font-size:1.5rem;flex-shrink:0;}
.error-text h5{font-size:13.5px;font-weight:700;color:var(--navy);margin-bottom:4px;}
.error-text p{font-size:13px;color:var(--gray-600);line-height:1.6;}
.error-fix{margin-top:7px;font-size:12.5px;font-weight:600;color:var(--green);display:flex;gap:6px;align-items:flex-start;}
.error-fix::before{content:'✓';flex-shrink:0;}

/* ACTION PLAN */
.action-plan{display:flex;flex-direction:column;gap:0;margin-top:28px;}
.ap-row{display:flex;gap:0;align-items:stretch;border-bottom:1px solid var(--gray-200);}
.ap-row:last-child{border-bottom:none;}
.ap-num{width:44px;flex-shrink:0;background:linear-gradient(135deg,var(--navy),var(--navy-lite));color:var(--teal);font-family:'DM Serif Display',serif;font-size:1.2rem;display:flex;align-items:center;justify-content:center;}
.ap-row:first-child .ap-num{border-radius:var(--r) 0 0 0;}
.ap-row:last-child .ap-num{border-radius:0 0 0 var(--r);}
.ap-content{flex:1;padding:16px 18px;background:var(--white);border:1px solid var(--gray-200);border-left:none;}
.ap-row:first-child .ap-content{border-radius:0 var(--r) 0 0;}
.ap-row:last-child .ap-content{border-radius:0 0 var(--r) 0;}
.ap-content h5{font-size:13.5px;font-weight:700;color:var(--navy);margin-bottom:4px;}
.ap-content p{font-size:13px;color:var(--gray-600);line-height:1.65;}
.ap-prompt{margin-top:8px;padding:8px 12px;background:var(--blue-lt);border-radius:8px;font-size:13px;color:var(--blue);font-weight:600;font-style:italic;}

/* CONCLUSION */
.conclusion{background:linear-gradient(155deg,var(--navy) 0%,var(--navy-mid) 60%,var(--navy-lite) 100%);color:var(--white);text-align:center;position:relative;overflow:hidden;}
.conclusion::before{content:'';position:absolute;top:-100px;left:50%;transform:translateX(-50%);width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(0,194,178,0.14) 0%,transparent 70%);pointer-events:none;}
.conclusion-inner{position:relative;z-index:1;}
.trophy{font-size:4rem;margin-bottom:16px;display:block;animation:float 3s ease-in-out infinite;}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);}}
.conclusion h2{font-family:'DM Serif Display',serif;font-size:clamp(1.7rem,6vw,2.2rem);margin-bottom:14px;line-height:1.2;}
.conc-body{font-size:15px;color:rgba(255,255,255,0.72);line-height:1.75;max-width:420px;margin:0 auto 28px;}
.conc-body strong{color:var(--white);}
.cta-btn{display:inline-flex;align-items:center;gap:10px;background:linear-gradient(135deg,var(--teal) 0%,var(--blue) 100%);color:var(--white);font-weight:700;font-size:14px;letter-spacing:1px;text-transform:uppercase;padding:15px 34px;border-radius:50px;box-shadow:0 8px 28px rgba(0,194,178,0.35);text-decoration:none;transition:transform .2s,box-shadow .2s;cursor:default;}
.cta-btn:hover{transform:translateY(-3px);box-shadow:0 14px 36px rgba(0,194,178,0.45);}
.cta-arrow{transition:transform .2s;}
.cta-btn:hover .cta-arrow{transform:translateX(4px);}

/* FOOTER */
footer{background:var(--navy);padding:24px 28px;text-align:center;color:rgba(255,255,255,0.35);font-size:11px;letter-spacing:1px;text-transform:uppercase;border-top:1px solid rgba(255,255,255,0.06);}
footer strong{color:rgba(255,255,255,0.6);}

/* ══ QUIZ ══════════════════════════════════════ */
.quiz-section{background:linear-gradient(160deg,#0D2644 0%,#0B1F3A 60%,#102238 100%);padding:52px 28px;}
.quiz-header{margin-bottom:32px;}
.quiz-header .section-label{color:var(--teal);}
.quiz-header .section-label::before{background:var(--teal);}
.quiz-header .section-title{color:var(--white);}
.quiz-header .section-body{color:rgba(255,255,255,0.62);}

/* progress */
.quiz-progress-wrap{margin-bottom:28px;}
.quiz-progress-meta{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;}
.quiz-progress-label{font-size:11px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;color:rgba(255,255,255,0.4);}
.quiz-progress-count{font-family:'DM Serif Display',serif;font-size:1.1rem;color:var(--teal);}
.quiz-progress-bar{height:4px;background:rgba(255,255,255,0.1);border-radius:4px;overflow:hidden;}
.quiz-progress-fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--blue));border-radius:4px;transition:width .45s cubic-bezier(.4,0,.2,1);}

/* question card */
.quiz-card{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:var(--r-lg);padding:26px 24px;backdrop-filter:blur(8px);}
.quiz-q-num{font-size:10px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--teal);margin-bottom:10px;}
.quiz-q-text{font-family:'DM Serif Display',serif;font-size:clamp(1.05rem,4vw,1.25rem);color:var(--white);line-height:1.45;margin-bottom:22px;}

/* options */
.quiz-options{display:flex;flex-direction:column;gap:10px;}
.quiz-opt{display:flex;align-items:flex-start;gap:14px;background:rgba(255,255,255,0.06);border:1.5px solid rgba(255,255,255,0.12);border-radius:var(--r);padding:14px 16px;cursor:pointer;transition:all .18s;text-align:left;width:100%;}
.quiz-opt:hover:not(:disabled){background:rgba(26,111,212,0.2);border-color:var(--blue);}
.quiz-opt:disabled{cursor:default;}
.quiz-opt.correct{background:rgba(13,189,116,0.18)!important;border-color:var(--green)!important;}
.quiz-opt.wrong  {background:rgba(224,58,58,0.18)!important;border-color:var(--red)!important;}
.quiz-opt.reveal {background:rgba(13,189,116,0.10)!important;border-color:rgba(13,189,116,0.4)!important;}
.opt-letter{width:28px;height:28px;border-radius:50%;background:rgba(255,255,255,0.1);border:1.5px solid rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:var(--white);flex-shrink:0;transition:all .18s;letter-spacing:.5px;}
.quiz-opt.correct .opt-letter{background:var(--green);border-color:var(--green);}
.quiz-opt.wrong   .opt-letter{background:var(--red);border-color:var(--red);}
.quiz-opt.reveal  .opt-letter{background:rgba(13,189,116,0.5);border-color:var(--green);}
.opt-text{font-size:14px;color:rgba(255,255,255,0.82);line-height:1.5;padding-top:3px;}
.quiz-opt.correct .opt-text,.quiz-opt.reveal .opt-text{color:var(--white);}

/* feedback box */
.quiz-feedback{margin-top:16px;padding:14px 16px;border-radius:var(--r);font-size:13.5px;line-height:1.6;display:none;}
.quiz-feedback.show{display:block;animation:fadeSlideUp .3s ease;}
.quiz-feedback.fb-correct{background:rgba(13,189,116,0.15);border:1px solid rgba(13,189,116,0.3);color:#A6F0D0;}
.quiz-feedback.fb-wrong  {background:rgba(224,58,58,0.12);border:1px solid rgba(224,58,58,0.25);color:#FFBEBE;}
.quiz-feedback strong{color:var(--white);}
@keyframes fadeSlideUp{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

/* nav button */
.quiz-nav{margin-top:22px;display:flex;justify-content:flex-end;}
.quiz-btn{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(135deg,var(--teal),var(--blue));color:var(--white);font-weight:700;font-size:13px;letter-spacing:.8px;text-transform:uppercase;padding:12px 26px;border-radius:40px;border:none;cursor:pointer;box-shadow:0 6px 20px rgba(0,194,178,0.3);transition:transform .18s,box-shadow .18s;opacity:0;pointer-events:none;transition:opacity .3s,transform .18s,box-shadow .18s;}
.quiz-btn.visible{opacity:1;pointer-events:auto;}
.quiz-btn:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(0,194,178,0.4);}

/* result screen */
.quiz-result{display:none;text-align:center;}
.quiz-result.show{display:block;animation:fadeSlideUp .4s ease;}
.result-badge{width:90px;height:90px;border-radius:50%;margin:0 auto 20px;display:flex;align-items:center;justify-content:center;font-size:2.6rem;position:relative;}
.result-badge::before{content:'';position:absolute;inset:-4px;border-radius:50%;background:conic-gradient(var(--teal) var(--pct,0%),rgba(255,255,255,0.08) 0%);transition:--pct 1s;}
.result-badge-inner{width:82px;height:82px;border-radius:50%;background:var(--navy);display:flex;align-items:center;justify-content:center;font-size:2.4rem;position:relative;z-index:1;}
.result-score-num{font-family:'DM Serif Display',serif;font-size:3rem;color:var(--white);line-height:1;margin-bottom:4px;}
.result-score-lbl{font-size:12px;color:rgba(255,255,255,0.45);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:16px;}
.result-title{font-family:'DM Serif Display',serif;font-size:1.6rem;color:var(--white);margin-bottom:10px;line-height:1.3;}
.result-msg{font-size:14px;color:rgba(255,255,255,0.65);line-height:1.7;max-width:380px;margin:0 auto 24px;}
.result-msg strong{color:var(--white);}
.result-bars{display:flex;flex-direction:column;gap:8px;margin:20px 0;text-align:left;}
.result-bar-row{display:flex;align-items:center;gap:10px;}
.result-bar-lbl{font-size:11px;color:rgba(255,255,255,0.5);width:90px;flex-shrink:0;letter-spacing:.5px;}
.result-bar-track{flex:1;height:6px;background:rgba(255,255,255,0.1);border-radius:3px;overflow:hidden;}
.result-bar-fill{height:100%;border-radius:3px;transition:width 1s cubic-bezier(.4,0,.2,1);}
.result-bar-val{font-size:12px;font-weight:700;color:var(--teal);width:30px;text-align:right;flex-shrink:0;}
.retry-btn{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,0.08);border:1.5px solid rgba(255,255,255,0.18);color:rgba(255,255,255,0.7);font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:10px 22px;border-radius:40px;cursor:pointer;transition:all .18s;margin-top:8px;}
.retry-btn:hover{background:rgba(255,255,255,0.14);color:var(--white);}

/* stars */
.result-stars{font-size:1.6rem;margin-bottom:8px;letter-spacing:4px;}

@media print{
  body{background:white;}
  section{break-inside:avoid;}
  .hero,.conclusion,.quiz-section{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
}
