    chame o supervisor antes de prosseguir.</div></div>
  ${r.length?`<div class="qgrid">${r.map(x=>`<button class="qcard" onclick="goRef('${x.eq}','${encodeURIComponent(x.tema)}')">
    <span class="qic">${ICO[x.ico]}</span><span class="qtx"><span class="qn">${esc(x.rot)}</span>
    <span class="qs">${esc(x.cap)} ${esc(x.sec)}</span></span></button>`).join('')}</div>`:''}
  ${ps.length?`<div class="sechead"><span class="n">Procedimento</span><h2>Passo a passo</h2></div>
    ${ps.map(p=>procCard(p)).join('')}`:''}
  ${ss.length?`<div class="sechead"><span class="n">Manual</span><h2>Páginas de segurança</h2></div>
    ${ss.map(s=>`<button class="vinc" onclick="verSec('${e.id}','${s.sid}')">
      <span class="vi">${ICO.img}</span><span class="vt"><span class="vn">${esc(s.tit)}</span>
      <span class="vs">${esc(s.doc_nome)} · pág. ${s.p0}${s.p1>s.p0?'–'+s.p1:''} · ${s.pgs.length} pág.</span></span>
      <span class="chev" style="transform:rotate(-90deg)">${ICO.chev}</span></button>`).join('')}`:''}`;
}

/* ---------- aba: diagnóstico (v1 preservado) ---------- */
function msgsFor(id){
  const f=D.msg_eq[id];
  if(!f)return [];
  if(f.grupos===null)return D.mensagens;
  return D.mensagens.filter(m=>(f.grupos||[]).includes(m.grupo)||(f.codigos||[]).includes(m.codigo));
}
function paneDiag(e){
  if(e.id==='detector') return paneDet()+paneMsg(e);
  if(e.id==='piab') return paneProbPIAB()+paneMsg(e);
  if(e.id==='polidor') return panePolidor()+paneMsg(e);
  let h='';
  if(e.id==='mg2'){
    h+=`<div class="gmp"><span class="ic">${ICO.warn}</span><div class="tx">
      <b>Escopo do operador:</b> causas marcadas <span class="opbadge">Operador</span> constam do Guia do Operador da linha.
      As demais exigem ajuste de parâmetro (<b>Supervisor</b>) ou intervenção mecânica (<b>Manutenção</b>).</div></div>`;
    h+=croquiHTML('escalonamento');
    const secs={};D.problemas.forEach(p=>{(secs[p.secao+' '+p.secao_titulo]=secs[p.secao+' '+p.secao_titulo]||[]).push(p);});
    h+=Object.entries(secs).map(([k,ps])=>`
      <div class="sechead"><span class="n">§${esc(k.split(' ')[0])}</span><h2>${esc(k.split(' ').slice(1).join(' '))}</h2></div>
      ${ps.map(p=>probCard(p)).join('')}`).join('');
  }
  h+=paneMsg(e);
  return h;
}
function probCard(p,q){
  const img=D.prob_img[p.num];
  return `<div class="prob" id="p${p.num}">
    <button class="probhd" onclick="tog(this.parentNode)">
      <span class="probnum">${p.num}</span>
      <span class="probttl">${hl(p.titulo,q)}<span class="probsub">${p.itens.length} causa${p.itens.length>1?'s':''} · §${esc(p.secao)}${p.secao_titulo?` · ${esc(p.secao_titulo)}`:''}</span></span>
      <span class="chev">${ICO.chev}</span></button>
    <div class="probbody">
      ${img?`<img class="probimg" src="${D.imgs[img]}" alt="Problema ${p.num}" loading="lazy">`:''}
      ${p.itens.map(it=>`<div class="cs ${it.operador?'op':''}">
        <div class="lbl">Causa provável ${it.operador?'<span class="opbadge">Operador</span>':''}</div>
        <div class="cz">${hl(it.causa,q)}</div><div class="lbl">Solução</div>
        <div class="sl">${hl(it.solucao,q)}</div></div>`).join('')}</div></div>`;
}
function paneMsg(e){
  let ms=msgsFor(e.id);if(!ms.length)return '';
  const all=ms;
  if(S.filt==='w')ms=ms.filter(m=>m.tipo==='AVISO');
  if(S.filt==='s')ms=ms.filter(m=>m.tipo==='PARADA');
  const nw=all.filter(m=>m.tipo==='AVISO').length,ns=all.filter(m=>m.tipo==='PARADA').length;
  const g={};ms.forEach(m=>{const k=(m.grupo||'—')+'|'+(m.grupo_titulo||'');(g[k]=g[k]||[]).push(m);});
  return `<div class="sechead"><span class="n">Painel da MG2</span><h2>Mensagens de diagnóstico${e.id!=='mg2'?` — ${esc(e.curto)}`:''}</h2></div>
  <div class="gmp info"><span class="ic">${ICO.info}</span><div class="tx">
    ${e.id!=='mg2'?`<b>Apenas as mensagens do painel da MG2 que se referem ao ${esc(e.curto)}.</b><br>`:''}
    <b>Como usar:</b> leia o código na barra de estado e digite-o na busca no topo. Amarelo = <b>AVISO</b> (máquina opera).
    Vermelho = <b>PARADA</b> (máquina parou). Alteração de configuração sem registro é desvio.</div></div>
  <div class="msgfilt">
    <button class="fbtn ${S.filt==='all'?'on':''}" onclick="setFilt('all')">Todas (${all.length})</button>
    <button class="fbtn w ${S.filt==='w'?'on':''}" onclick="setFilt('w')">Avisos (${nw})</button>
    <button class="fbtn s ${S.filt==='s'?'on':''}" onclick="setFilt('s')">Paradas (${ns})</button></div>
  ${Object.entries(g).map(([k,mm])=>{const[gid,gt]=k.split('|');
    return `<div class="sechead"><span class="n">§${esc(gid)}</span><h2>${esc(gt)}</h2></div>${mm.map(m=>msgCard(m)).join('')}`;}).join('')}`;
}
function msgCard(m,q){
  const st=m.tipo==='PARADA';
  return `<div class="msg ${st?'stop':''}" id="m${m.codigo}">
    <button class="msghd" onclick="tog(this.parentNode)">
      <span class="msgcode mono">${hl(m.codigo,q)}</span>
      <span class="msgmid"><span class="msgttl">${hl(m.titulo,q)}</span>
        <span class="msgmeta"><span class="badge ${st?'s':'w'}">${st?'Parada':'Aviso'}</span>${m.nd?`<span class="badge nd">relatado em operação · não consta no manual</span>`:''}
        ${(m.categorias||[]).map(c=>`<span class="badge c">${esc(c)} · ${esc(catName(c))}</span>`).join('')}</span></span>
      <span class="chev">${ICO.chev}</span></button>
    <div class="msgbody">
      ${m.nd?`<div class="ndnote">Alarme registrado durante a operação e ausente dos manuais fornecidos. As causas e verificações abaixo são hipóteses de engenharia para orientar a investigação — não são instruções oficiais do fabricante. Não seguir cegamente: confirmar com a Manutenção e com a Maquidrex antes de padronizar.</div>`:''}
      ${m.onde?`<div class="fld"><div class="lbl">Onde aparece</div><div class="val">${esc(m.onde)}</div></div>`:''}
      <div class="fld"><div class="lbl">${m.nd?'Causas potenciais — sugestão, não oficial':'Causa'}</div><div class="val">${hl(m.causa,q)}</div></div>
      ${m.solucao?`<div class="fld sol"><div class="lbl">${m.nd?'Verificações sugeridas — validar antes de seguir':'Solução'}</div><div class="val">${hl(m.solucao,q)}</div></div>`:''}
    </div></div>`;
}
function paneProbPIAB(){
  const g={};D.piab_problemas.forEach(p=>{(g[p.sintoma]=g[p.sintoma]||[]).push(p);});
  return `<div class="gmp info"><span class="ic">${ICO.info}</span><div class="tx">
    <b>Tradução livre</b> da tabela TROUBLE-SHOOTING do manual 6506_CMM013 (pág. 19-20). A coluna
    <b>Posição</b> corresponde aos números do croqui abaixo.</div></div>
  ${croquiHTML('piab_posicoes')}
  ${Object.entries(g).map(([s,ps])=>`<div class="tblwrap"><table class="tbl">
    <thead><tr><th colspan="4">${esc(s)}</th></tr>
    <tr><th style="width:32%">Causa</th><th style="width:20%">Posição</th><th style="width:36%">Ação</th><th style="width:12%">Quem</th></tr></thead>
    <tbody>${ps.map(p=>`<tr><td>${esc(p.causa)}</td><td>${esc(p.posicao)}</td><td>${esc(p.acao)}</td>
      <td><span class="who ${whoCls(p.quem)}">${esc(p.quem)}</span></td></tr>`).join('')}</tbody></table></div>`).join('')}`;
}
function paneDet(){
  return `<div class="gmp info"><span class="ic">${ICO.info}</span><div class="tx">
    <b>Tradução livre</b> do autodiagnóstico do manual 6506_IML006 (§5.2.1 a §5.2.3, pág. 46-48).
    <b>SC</b> é o código de falha no display.</div></div>
  <div class="sechead"><span class="n">§5.2.1 e §5.2.2</span><h2>Falhas (Fault)</h2></div>
  <div class="tblwrap"><table class="tbl"><thead><tr><th style="width:22%">Mensagem</th><th style="width:7%">SC</th>
    <th style="width:31%">Causa provável</th><th style="width:29%">Ação</th><th style="width:11%">Quem</th></tr></thead>
    <tbody>${D.det_falhas.map(f=>`<tr><td><b class="mono">${esc(f.msg)}</b></td><td class="mono">${esc(f.sc)}</td>
      <td>${esc(f.causa)}</td><td>${esc(f.acao)}</td><td><span class="who ${whoCls(f.quem)}">${esc(f.quem)}</span></td></tr>`).join('')}</tbody></table></div>
  <div class="sechead"><span class="n">§5.2.3</span><h2>Mensagens de aviso (Warning)</h2></div>
  <div class="tblwrap"><table class="tbl"><thead><tr><th style="width:24%">Mensagem</th><th style="width:36%">Causa</th>
    <th style="width:40%">Ação</th></tr></thead>
    <tbody>${D.det_avisos.map(a=>`<tr><td><b class="mono">${esc(a.msg)}</b></td><td>${esc(a.causa)}</td>
      <td>${esc(a.acao)}</td></tr>`).join('')}</tbody></table></div>`;
}
function panePolidor(){
  return `<div class="panel"><h3>Código de cor da luz de alarme</h3><p>Manual 6506_IML015, §6.12.1 (pág. 39).</p>
    ${D.pol_cores.map(c=>`<div class="colorrow"><span class="dot" style="background:${c.hex}"></span>
      <span class="cn">${esc(c.cor)}</span><span class="cs2">${esc(c.sig)}</span></div>`).join('')}</div>
  <div class="panel"><h3>Tela de produção da HMI — cores do desviador</h3><p>§6.12.2 e §6.12.3 (pág. 40-41).</p>
    ${D.pol_hmi.map(c=>`<div class="colorrow"><span class="dot" style="background:${c.hex}"></span>
      <span class="cn">${esc(c.cor)}</span><span class="cs2">${esc(c.sig)} <b style="color:#7b8b99;font-weight:600">· ${esc(c.desv)}</b></span></div>`).join('')}</div>
  <div class="panel"><h3>Alarmes do polidor</h3><p>${esc(D.pol_alarme.txt)}</p>
    <div class="note w"><b>Atenção:</b> ${esc(D.pol_alarme.nota)}</div></div>`;
}

/* ---------- busca ---------- */
function search(q){
  const n=nrm(q),out={msg:[],prob:[],proc:[],lim:[],ref:[],piab:[],det:[]};
  if(n.length<2)return out;
  const isCode=/^\d{3,8}$/.test(q.trim());
  D.mensagens.forEach(m=>{const hay=nrm(m.codigo+' '+m.titulo+' '+m.causa+' '+m.solucao+' '+(m.grupo_titulo||''));
    if(isCode?m.codigo.includes(q.trim()):hay.includes(n))out.msg.push(m);});
  if(isCode){const t=q.trim();const rk=c=>c===t?0:(c.startsWith(t)?1:(c.endsWith(t)?2:3));
    out.msg.sort((a,b)=>rk(a.codigo)-rk(b.codigo)||a.codigo.localeCompare(b.codigo));return out;}
  [...D.procedimentos,...D.proc_outros].forEach(p=>{
    const hay=nrm(p.titulo+' '+(p.sec_tit||'')+' '+p.passos.map(s=>s.txt).join(' '));
    if(hay.includes(n))out.proc.push(p);});
  D.limpeza.forEach(c=>{if(nrm(c.titulo+' '+c.itens.join(' ')).includes(n))out.lim.push(c);});
  D.problemas.forEach(p=>{if(nrm(p.titulo+' '+p.itens.map(i=>i.causa+' '+i.solucao).join(' ')).includes(n))out.prob.push(p);});
  Object.entries(D.indice2).forEach(([dd,rows])=>rows.forEach(x=>{
    if(nrm(x.s+' '+x.t).includes(n))out.ref.push({did:dd,x:x});}));
  D.piab_problemas.forEach(p=>{if(nrm(p.sintoma+' '+p.causa+' '+p.acao).includes(n))out.piab.push(p);});
  [...D.det_falhas,...D.det_avisos.map(a=>({...a,sc:'—',quem:'—'}))].forEach(d=>{
    if(nrm(d.msg+' '+d.causa+' '+d.acao).includes(n))out.det.push(d);});
  return out;
}
function viewSearch(q){
  const r=search(q);
  const tot=r.msg.length+r.prob.length+r.proc.length+r.lim.length+r.ref.length+r.piab.length+r.det.length;
  if(q.trim().length<2)return `<div class="empty"><div class="big">Digite ao menos 2 caracteres</div>
    <div class="sm">Busque o código do alarme (ex.: 1013000), o nome de um procedimento<br>(ex.: dosadores, vácuo, tremonha) ou uma palavra do passo.</div></div>`;
  if(!tot)return `<div class="empty"><div class="big">Nada encontrado para "${esc(q)}"</div>
    <div class="sm">Tente o código completo, uma palavra-chave mais curta,<br>ou navegue pela ação no início.</div></div>`;
  let h=`<div class="rescnt"><b>${tot}</b> resultado${tot>1?'s':''} para "${esc(q)}"</div>`;
  if(r.proc.length)h+=`<div class="resgrp"><div class="gh">Procedimentos · ${r.proc.length}</div>
    ${r.proc.slice(0,25).map(p=>procCard(p,q)).join('')}
    ${r.proc.length>25?`<div class="rescnt">Mostrando 25 de ${r.proc.length}.</div>`:''}</div>`;
  if(r.lim.length)h+=`<div class="resgrp"><div class="gh">Limpeza · ${r.lim.length}</div>${r.lim.map(c=>limpCard(c,q)).join('')}</div>`;
  if(r.msg.length)h+=`<div class="resgrp"><div class="gh">Mensagens de diagnóstico MG2 · ${r.msg.length}</div>
    ${r.msg.slice(0,30).map(m=>msgCard(m,q)).join('')}
    ${r.msg.length>30?`<div class="rescnt">Mostrando 30 de ${r.msg.length}. Refine a busca.</div>`:''}</div>`;
  if(r.prob.length)h+=`<div class="resgrp"><div class="gh">Problemas de processo MG2 · ${r.prob.length}</div>
    ${r.prob.map(p=>probCard(p,q)).join('')}</div>`;
  if(r.piab.length)h+=`<div class="resgrp"><div class="gh">Problemas do PIAB · ${r.piab.length}</div>
    <div class="tblwrap"><table class="tbl"><thead><tr><th>Sintoma</th><th>Causa</th><th>Ação</th><th>Quem</th></tr></thead>
    <tbody>${r.piab.map(p=>`<tr><td><b>${hl(p.sintoma,q)}</b></td><td>${hl(p.causa,q)}</td><td>${hl(p.acao,q)}</td>
      <td><span class="who ${whoCls(p.quem)}">${esc(p.quem)}</span></td></tr>`).join('')}</tbody></table></div></div>`;
  if(r.det.length)h+=`<div class="resgrp"><div class="gh">Falhas do Detector de Metais · ${r.det.length}</div>
    <div class="tblwrap"><table class="tbl"><thead><tr><th>Mensagem</th><th>SC</th><th>Causa</th><th>Ação</th></tr></thead>
    <tbody>${r.det.map(d=>`<tr><td><b class="mono">${hl(d.msg,q)}</b></td><td class="mono">${esc(d.sc)}</td>
      <td>${hl(d.causa,q)}</td><td>${hl(d.acao,q)}</td></tr>`).join('')}</tbody></table></div></div>`;
  if(r.ref.length)h+=`<div class="resgrp"><div class="gh">Onde consultar no manual · ${r.ref.length}</div>
    <div class="panel">${r.ref.slice(0,25).map(o=>`<button class="idxrow lk" onclick="zoomPg('${o.did}',${o.x.p})">
      <div><div class="t">${o.x.s!=='—'?`<span class="secn">${esc(o.x.s)}</span> `:''}${hl(o.x.t,q)}</div>
      <div class="src">${esc((MANUAIS[o.did]||{nome:o.did}).nome)}</div></div>
      <div class="ref"><span class="pg">pág. ${o.x.p}</span><span class="go">ver página ›</span></div></button>`).join('')}</div></div>`;
  return h;
}

/* ---------- render ---------- */
function render(){
  const q=document.getElementById('q').value;const app=document.getElementById('app');
  document.getElementById('clr').className='sclear'+(q?' on':'');
  if(q.trim())app.innerHTML=viewSearch(q);
  else if(S.view==='eq')app.innerHTML=viewEq();
  else if(S.view==='acoes')app.innerHTML=viewAcoes();
  else app.innerHTML=viewHome();
}
let tmr;
document.getElementById('q').addEventListener('input',()=>{clearTimeout(tmr);tmr=setTimeout(render,140);});
document.getElementById('q').addEventListener('keydown',e=>{if(e.key==='Escape')clearQ();});
window.addEventListener('scroll',()=>{document.getElementById('top').className='fx'+(window.scrollY>500?' on':'');});
render();
</script>
