<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#004970">
<title>Guia do Operador — Diagnóstico de Falhas · Biolab &amp; Co.</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --navy:#004970;--navy-d:#00334f;--blue:#008FC4;--blue-l:#EAF2F9;
  --ink:#12212c;--ink-2:#465868;--ink-3:#7b8b99;
  --bg:#eef3f7;--card:#fff;--line:#d5e0e9;
  --warn:#E8A33D;--warn-bg:#FDF4E3;--stop:#D64545;--stop-bg:#FBECEC;
  --ok:#1E8E5A;--ok-bg:#E7F5EE;
  --r:10px;--sh:0 1px 3px rgba(0,45,75,.10),0 6px 18px -8px rgba(0,45,75,.16);--fs:16px;
}
html{font-size:var(--fs)}
body{font-family:"Plus Jakarta Sans","Segoe UI",Roboto,-apple-system,system-ui,Arial,sans-serif;
  background:var(--bg);color:var(--ink);line-height:1.5;-webkit-text-size-adjust:100%;overscroll-behavior-y:none}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
.mono{font-family:"SF Mono",Menlo,Consolas,"Roboto Mono",monospace;font-variant-numeric:tabular-nums}

header{position:sticky;top:0;z-index:50;background:var(--navy);color:#fff;box-shadow:0 2px 12px rgba(0,45,75,.28)}
.hbar{display:flex;align-items:center;gap:14px;padding:10px 18px;max-width:1240px;margin:0 auto}
.hlogo{height:30px;flex:none;filter:brightness(0) invert(1)}
.htit{font-size:.95rem;font-weight:700;line-height:1.2}
.htit small{display:block;font-size:.7rem;font-weight:500;opacity:.7;letter-spacing:.06em;text-transform:uppercase;margin-top:1px}
.hspace{flex:1}
.hbtn{display:flex;align-items:center;gap:7px;padding:9px 15px;border-radius:8px;background:rgba(255,255,255,.13);
  font-size:.85rem;font-weight:600;min-height:42px}
.hbtn:active{background:rgba(255,255,255,.26)}

.searchwrap{background:var(--navy-d);padding:0 18px 13px}
.searchin{max-width:1240px;margin:0 auto;position:relative}
#q{width:100%;padding:14px 46px;border-radius:9px;border:2px solid transparent;background:#fff;
  font-size:1.02rem;font-weight:500;color:var(--ink);outline:none}
#q:focus{border-color:var(--blue)}
#q::placeholder{color:var(--ink-3);font-weight:400}
.sicon{position:absolute;left:15px;top:50%;transform:translateY(-50%);color:var(--ink-3);pointer-events:none}
.sclear{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:34px;height:34px;border-radius:7px;
  color:var(--ink-3);font-size:1.3rem;line-height:1;display:none}
.sclear.on{display:block}
.shint{max-width:1240px;margin:8px auto 0;font-size:.76rem;color:rgba(255,255,255,.62)}
.shint b{color:#8fd2f0;font-weight:600}

main{max-width:1240px;margin:0 auto;padding:20px 18px 90px}
.crumb{display:flex;align-items:center;gap:7px;flex-wrap:wrap;font-size:.82rem;color:var(--ink-2);margin-bottom:16px}
.crumb button{color:var(--blue);font-weight:600;text-decoration:underline;text-underline-offset:2px}
.crumb span.sep{color:var(--ink-3)}
h1{font-size:1.45rem;font-weight:800;letter-spacing:-.015em;line-height:1.2}
h2{font-size:1.05rem;font-weight:700;margin-bottom:12px}
.lead{color:var(--ink-2);font-size:.92rem;margin-top:5px;max-width:75ch}
.sechead{display:flex;align-items:baseline;gap:10px;margin:26px 0 12px}
.sechead h2{margin:0}
.sechead .n{font-size:.72rem;font-weight:700;color:var(--ink-3);letter-spacing:.1em;text-transform:uppercase}

/* AÇÕES (nível 0) */
.agrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(238px,1fr));gap:13px}
.acard{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);padding:18px 17px;text-align:left;
  display:flex;flex-direction:column;gap:8px;border-top:4px solid var(--blue);min-height:132px;transition:transform .1s}
.acard:active{transform:scale(.985)}
.acard .ai{color:var(--blue);display:flex}
.acard .an{font-size:1.08rem;font-weight:800;line-height:1.2}
.acard .ad{font-size:.83rem;color:var(--ink-2);line-height:1.45;flex:1}
.acard .ac{font-size:.72rem;font-weight:800;color:var(--blue);letter-spacing:.05em;text-transform:uppercase}
.acard.diag{border-top-color:var(--stop)}.acard.diag .ai,.acard.diag .ac{color:var(--stop)}
.acard.seg{border-top-color:var(--warn)}.acard.seg .ai,.acard.seg .ac{color:#b07d15}

/* FLUXO */
.flowbox{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);padding:18px 14px 10px;overflow-x:auto}
.flowsvg{display:block;min-width:840px;width:100%;height:auto}
.st-box{fill:#fff;stroke:var(--line);stroke-width:1.5;transition:fill .12s,stroke .12s}
.st-hit{cursor:pointer}
.st-hit:active .st-box,.st-hit:hover .st-box{fill:var(--blue-l);stroke:var(--blue)}
.st-num{fill:var(--blue);font-size:11px;font-weight:800;font-family:inherit}
.st-nm{fill:var(--navy);font-size:12.5px;font-weight:700;font-family:inherit}
.st-eq{fill:var(--ink-3);font-size:10.5px;font-weight:600;font-family:inherit;letter-spacing:.04em}
.st-ic{color:var(--blue);opacity:.85}
.st-hit:hover .st-ic,.st-hit:active .st-ic{opacity:1}
.arrow{stroke:var(--ink-3);stroke-width:1.6;fill:none;marker-end:url(#ah)}
.flownote{font-size:.75rem;color:var(--ink-3);text-align:center;padding:8px 0 2px}

/* EQUIPAMENTOS */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:13px}
.eqcard{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);padding:16px;text-align:left;
  display:flex;flex-direction:column;gap:7px;border-left:4px solid var(--blue);transition:transform .1s}
.eqcard:active{transform:scale(.985)}
.eqcard .tag{font-size:.68rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--blue)}
.eqcard .nm{font-size:1.02rem;font-weight:700;line-height:1.25}
.eqcard .pp{font-size:.83rem;color:var(--ink-2);line-height:1.45}
.eqcard .ft{display:flex;gap:6px;flex-wrap:wrap;margin-top:4px}
.pill{font-size:.7rem;font-weight:700;padding:3px 9px;border-radius:20px;background:var(--blue-l);color:var(--navy)}
.pill.en{background:#F2E9DC;color:#7a5a24}
.pill.z{background:#f0f3f5;color:var(--ink-3)}

/* ACESSO RÁPIDO */
.qgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(232px,1fr));gap:11px}
.qcard{display:flex;align-items:center;gap:12px;background:var(--card);border-radius:var(--r);box-shadow:var(--sh);
  padding:14px 15px;text-align:left;border-left:4px solid var(--stop);min-height:64px}
.qcard:active{background:var(--blue-l)}
.qic{flex:none;color:var(--stop);display:flex}
.qtx{flex:1;min-width:0}
.qn{display:block;font-size:.9rem;font-weight:700;line-height:1.3}
.qs{display:block;font-size:.73rem;color:var(--ink-3);font-weight:600;margin-top:2px}
.idxrow.hi{background:#fff6dd;border-radius:8px;padding-left:11px;padding-right:11px;box-shadow:inset 3px 0 0 var(--warn)}

/* ABAS / FILTROS */
.tabs{display:flex;gap:5px;background:var(--card);border-radius:var(--r);padding:5px;box-shadow:var(--sh);
  margin:16px 0 18px;overflow-x:auto}
.tab{padding:11px 15px;border-radius:7px;font-size:.86rem;font-weight:700;color:var(--ink-2);white-space:nowrap;min-height:44px}
.tab.on{background:var(--navy);color:#fff}
.tab .cnt{font-size:.72rem;opacity:.65;margin-left:5px;font-weight:600}
.msgfilt{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:13px}
.fbtn{padding:9px 14px;border-radius:20px;font-size:.8rem;font-weight:700;background:var(--card);
  color:var(--ink-2);box-shadow:var(--sh);min-height:40px}
.fbtn.on{background:var(--navy);color:#fff}
.fbtn.on.w{background:var(--warn);color:#3d2a06}
.fbtn.on.s{background:var(--stop);color:#fff}

.panel{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);padding:18px;margin-bottom:13px}
.panel h3{font-size:.98rem;font-weight:700;margin-bottom:9px}
.panel p{font-size:.9rem;color:var(--ink-2);line-height:1.55}

/* PROCEDIMENTOS */
.proc{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);margin-bottom:11px;overflow:hidden;
  border-left:4px solid var(--blue)}
.prochd{width:100%;display:flex;align-items:center;gap:13px;padding:15px 16px;text-align:left;min-height:64px}
.prochd:active{background:var(--blue-l)}
.procix{flex:none;width:38px;height:38px;border-radius:9px;background:var(--blue-l);color:var(--navy);
  display:flex;align-items:center;justify-content:center}
.procttl{flex:1;font-size:.96rem;font-weight:700;line-height:1.3}
.procsub{font-size:.74rem;color:var(--ink-3);font-weight:600;margin-top:4px;display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.chev{flex:none;color:var(--ink-3);transition:transform .18s}
.proc.open .chev{transform:rotate(180deg)}
.procbody{display:none;padding:4px 16px 18px;border-top:1px solid var(--line)}
.proc.open .procbody{display:block}
.fonte{font-size:.75rem;color:var(--ink-3);padding:11px 0 4px;line-height:1.45}
.fonte b{color:var(--ink-2);font-weight:700}

.step{display:flex;gap:13px;padding:12px 0;border-bottom:1px solid var(--line)}
.step:last-child{border-bottom:none}
.step .sn{flex:none;width:29px;height:29px;border-radius:8px;background:var(--navy);color:#fff;
  font-size:.82rem;font-weight:800;display:flex;align-items:center;justify-content:center}
.step .sx{flex:1;font-size:.9rem;line-height:1.5;padding-top:4px}
.step.gap .sn{background:#f0f3f5;color:var(--ink-3);border:1px dashed var(--ink-3)}
.step.gap .sx{color:var(--ink-3);font-style:italic;font-size:.85rem}
.gaphint{display:inline-block;font-size:.68rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;
  background:var(--warn-bg);color:#8a5c08;padding:2px 8px;border-radius:20px;margin-left:6px;font-style:normal}

/* TEXTO ESTRUTURADO DO MANUAL */
.tstit{font-size:.87rem;font-weight:700;color:var(--navy);margin:15px 0 -4px;padding:8px 12px;
  background:var(--blue-l);border-radius:8px;border-left:3px solid var(--blue)}
.tbody{padding-top:4px}
.tbody .tp{font-size:.89rem;line-height:1.6;color:var(--ink-2);margin:11px 0}
.tul{margin:11px 0 11px 4px;padding:0;list-style:none}
.tul li{position:relative;padding-left:19px;font-size:.88rem;line-height:1.55;color:var(--ink);margin-bottom:7px}
.tul li:before{content:'';position:absolute;left:4px;top:.6em;width:6px;height:6px;border-radius:50%;background:var(--blue)}
.tul.sub{margin:8px 0 4px}
.tul.sub li{font-size:.85rem;color:var(--ink-2)}
.tsteps{margin:13px 0;padding:0;list-style:none;counter-reset:st}
.tsteps>li{display:flex;gap:12px;padding:11px 0;border-bottom:1px solid var(--line)}
.tsteps>li:last-child{border-bottom:none}
.tsn{flex:none;width:28px;height:28px;border-radius:8px;background:var(--navy);color:#fff;
  font-size:.8rem;font-weight:800;display:flex;align-items:center;justify-content:center}
.tsx{flex:1;font-size:.89rem;line-height:1.55;padding-top:3px}
.tsteps>li.fig .tsn{background:#f0f3f5;color:var(--ink-3);border:1px dashed var(--ink-3)}
.tsfig{color:var(--ink-3);font-size:.84rem}
.tsrot{display:inline-block;background:var(--navy);color:#fff;font-size:.7rem;font-weight:700;
  padding:2px 8px;border-radius:5px;margin-right:7px;vertical-align:1px;font-family:"SF Mono",Menlo,monospace}
.tsbtn{display:block;margin-top:7px}
.tsbtn b{display:inline-block;background:var(--blue-l);color:var(--navy);font-size:.74rem;font-weight:700;
  padding:4px 10px;border-radius:6px;margin:0 6px 4px 0;border:1px solid #c7dced}
.tnote{display:flex;gap:10px;padding:11px 13px;border-radius:9px;margin:11px 0;align-items:flex-start}
.tnote.i{background:var(--blue-l);border-left:3px solid var(--blue)}
.tnote.w{background:var(--warn-bg);border-left:3px solid var(--warn)}
.tnote.s{background:var(--stop-bg);border-left:3px solid var(--stop)}
.tnk{flex:none;font-size:.66rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;padding-top:2px}
.tnote.i .tnk{color:var(--navy)} .tnote.w .tnk{color:#8a5c08} .tnote.s .tnk{color:#9c2626}
.tnx{flex:1;font-size:.86rem;line-height:1.55;color:var(--ink)}
.tnote.sub{margin:8px 0 2px;padding:9px 11px}
.tlbl{margin:11px 0;background:#f7fafc;border:1px solid var(--line);border-radius:9px;padding:11px 13px}
.tlbl.sub{margin:8px 0 2px}
.tlr{display:flex;gap:10px;padding:5px 0;font-size:.86rem;line-height:1.5}
.tlk{flex:none;width:22px;height:22px;border-radius:6px;background:var(--navy);color:#fff;
  font-size:.72rem;font-weight:800;display:flex;align-items:center;justify-content:center}

/* FIGURAS INLINE */
.figs{margin-top:15px;background:#f7fafc;border:1px solid var(--line);border-radius:10px;padding:13px}
.figh{display:flex;gap:9px;align-items:flex-start;color:var(--blue);margin-bottom:10px}
.figh b{font-size:.86rem;font-weight:700;color:var(--navy);display:block;line-height:1.3}
.figs2{font-size:.74rem;color:var(--ink-3);font-weight:600;display:block;margin-top:2px}
.figrow{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:9px}
.figimg{width:100%;border-radius:7px;border:1px solid var(--line);background:#fff;cursor:zoom-in;
  display:block;transition:transform .1s}
.figimg:active{transform:scale(.98)}
.figmore{margin-top:10px;width:100%;padding:11px;border-radius:8px;background:var(--blue-l);
  color:var(--navy);font-size:.82rem;font-weight:700;min-height:44px}
.figmore:active{background:#dceaf5}
.zoom{position:fixed;inset:0;z-index:200;background:rgba(0,25,42,.92);display:none;
  align-items:center;justify-content:center;padding:14px;overflow:auto;cursor:zoom-out}
.zoom.on{display:flex}
.zoom img{max-width:100%;max-height:96vh;border-radius:8px;background:#fff}
.badge.i{background:var(--blue-l);color:var(--navy)}
.secgrp{margin-bottom:14px}
.sgh{font-size:.71rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);margin-bottom:7px}
.fbn{opacity:.55;font-weight:700;margin-left:6px;font-size:.72rem}
.pn2{display:block;font-size:.73rem;color:var(--ink-3);font-weight:600;margin-top:2px}
.pn{text-align:center;line-height:1.3}

/* VÍNCULO PARA FIGURA */
.vinc{display:flex;align-items:center;gap:12px;width:100%;text-align:left;margin-top:11px;
  background:var(--blue-l);border-radius:9px;padding:13px 14px;border-left:3px solid var(--blue);min-height:58px}
.vinc:active{background:#dceaf5}
.vinc .vi{flex:none;color:var(--blue);display:flex}
.vinc .vt{flex:1;min-width:0}
.vinc .vn{display:block;font-size:.87rem;font-weight:700;color:var(--navy);line-height:1.3}
.vinc .vs{display:block;font-size:.75rem;color:var(--ink-2);margin-top:2px}
.vinc .chev{color:var(--blue)}

/* CROQUI */
.croq{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:14px;margin:14px 0}
.croq svg{display:block;width:100%;height:auto}
.croq .ct{font-size:.85rem;font-weight:700;color:var(--navy);margin-bottom:4px}
.croq .cf{font-size:.74rem;color:var(--ink-3);line-height:1.45;margin-top:9px;padding-top:9px;border-top:1px solid var(--line)}

/* PÁGINAS DO MANUAL */
.mansel{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:13px}
.pagenav{display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--card);
  border-radius:var(--r);box-shadow:var(--sh);padding:10px 13px;margin-bottom:11px;position:sticky;top:118px;z-index:20}
.pagenav .pn{font-size:.85rem;font-weight:700;color:var(--navy)}
.nbtn{width:46px;height:46px;border-radius:9px;background:var(--blue-l);color:var(--navy);
  display:flex;align-items:center;justify-content:center}
.nbtn:disabled{opacity:.3}
.nbtn:active:not(:disabled){background:var(--blue);color:#fff}
.pgimg{width:100%;max-width:760px;margin:0 auto;display:block;border-radius:8px;border:1px solid var(--line);background:#fff}
.pgwrap{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);padding:13px;text-align:center}
.pgjump{display:flex;gap:5px;flex-wrap:wrap;justify-content:center;margin-top:13px;max-height:96px;overflow-y:auto}
.pgj{width:36px;height:36px;border-radius:7px;background:#f2f6f9;font-size:.78rem;font-weight:700;color:var(--ink-2)}
.pgj.on{background:var(--navy);color:#fff}

/* ÍNDICE / TABELAS / MENSAGENS (v1 preservado) */
.idxgrp{margin-bottom:18px}
.idxgrp>.gt{font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--blue);
  padding:0 0 7px;border-bottom:2px solid var(--blue-l);margin-bottom:2px}
.idxrow{display:grid;grid-template-columns:1fr auto;gap:8px 14px;align-items:center;padding:11px 2px;border-bottom:1px solid var(--line)}
.idxrow:last-child{border-bottom:none}
.idxrow .t{font-size:.9rem;font-weight:600;line-height:1.35}
.idxrow .src{font-size:.75rem;color:var(--ink-3);margin-top:2px}
.ref{font-size:.78rem;font-weight:700;color:var(--navy);background:var(--blue-l);padding:6px 11px;border-radius:7px;
  white-space:nowrap;text-align:center;line-height:1.3}
.ref .pg{display:block;font-size:.68rem;color:var(--ink-2);font-weight:600}

.prob{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);margin-bottom:11px;overflow:hidden}
.probhd{width:100%;display:flex;align-items:center;gap:13px;padding:15px 16px;text-align:left;min-height:60px}
.probhd:active{background:var(--blue-l)}
.probnum{flex:none;width:34px;height:34px;border-radius:8px;background:var(--navy);color:#fff;
  font-size:.85rem;font-weight:800;display:flex;align-items:center;justify-content:center}
.probttl{flex:1;font-size:.96rem;font-weight:700;line-height:1.3}
.probsub{font-size:.74rem;color:var(--ink-3);font-weight:600;margin-top:3px}
.prob.open .chev{transform:rotate(180deg)}
.probbody{display:none;padding:0 16px 16px;border-top:1px solid var(--line)}
.prob.open .probbody{display:block}
.probimg{width:100%;max-width:430px;margin:14px auto;display:block;border-radius:8px;border:1px solid var(--line);background:#fff}
.cs{border-left:3px solid var(--line);padding:11px 0 11px 14px;margin-bottom:11px}
.cs.op{border-left-color:var(--ok)}
.cs .lbl{font-size:.68rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-3);margin-bottom:3px}
.cs .cz{font-size:.9rem;font-weight:600;line-height:1.45;margin-bottom:9px}
.cs .sl{font-size:.89rem;color:var(--ink-2);line-height:1.5}
.opbadge{display:inline-block;font-size:.65rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  background:var(--ok-bg);color:var(--ok);padding:2px 8px;border-radius:20px;margin-left:7px;vertical-align:middle}

.msg{background:var(--card);border-radius:var(--r);box-shadow:var(--sh);margin-bottom:9px;overflow:hidden;border-left:4px solid var(--warn)}
.msg.stop{border-left-color:var(--stop)}
.msghd{width:100%;display:flex;align-items:flex-start;gap:12px;padding:14px 15px;text-align:left;min-height:58px}
.msghd:active{background:var(--blue-l)}
.msgcode{flex:none;font-size:.9rem;font-weight:800;color:var(--navy);background:var(--blue-l);padding:5px 9px;border-radius:6px}
.msgmid{flex:1;min-width:0}
.msgttl{font-size:.9rem;font-weight:700;line-height:1.32;word-break:break-word}
.msgmeta{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;align-items:center}
.badge{font-size:.64rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase;padding:3px 8px;border-radius:20px}
.badge.w{background:var(--warn-bg);color:#8a5c08}
.badge.s{background:var(--stop-bg);color:#9c2626}
.badge.c{background:#eef2f5;color:var(--ink-2)}
.badge.a{background:var(--blue-l);color:var(--navy)}
.msgbody{display:none;padding:0 15px 16px;border-top:1px solid var(--line)}
.msg.open .msgbody{display:block}
.fld{margin-top:13px}
