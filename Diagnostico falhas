function zpNav(d){const n=ZP.pg+d;if(D.paginas[ZP.doc+'_'+n]){ZP.pg=n;drawZP();}}
function refCount(id){
  const ids=D.doc_eq[id]||[];let n=0;
  ids.forEach(d=>{const rs=D.indice2[d]||[];
    n+=(S.acao&&!S.refall)?rs.filter(x=>x.a.includes(S.acao)).length:rs.length;});
  return n;
}
function secRow(did,x,q){
  return `<button class="idxrow lk" onclick="zoomPg('${did}',${x.p})">
    <div><div class="t">${x.s!=='—'?`<span class="secn">${esc(x.s)}</span> `:''}${q?hl(x.t,q):esc(x.t)}</div></div>
    <div class="ref"><span class="pg">pág. ${x.p}</span><span class="go">ver página ›</span></div></button>`;
}
function paneRef(e){
  const ids=D.doc_eq[e.id]||[];
  const filt=!!(S.acao&&!S.refall);
  let tot=0,shown=0;
  const groups=ids.map(did=>{
    const man=MANUAIS[did]||{nome:did,pgs:0};
    const all=D.indice2[did]||[];
    const rows=filt?all.filter(x=>x.a.includes(S.acao)):all;
    tot+=all.length;shown+=rows.length;
    if(!rows.length)return '';
    const open=filt&&rows.length<=15;
    return `<div class="refdoc ${open?'open':''}">
      <button class="refdochd" onclick="tog(this.parentNode)">
        <span class="rdname">${esc(man.nome)}</span>
        <span class="rdmeta">${rows.length} seç${rows.length>1?'ões':'ão'} · ${man.pgs} pág.</span>
        <span class="chev">${ICO.chev}</span></button>
      <div class="refsecs">${rows.map(x=>secRow(did,x)).join('')}</div></div>`;
  }).join('');
  const fbar=S.acao?`<div class="refbar">${filt
    ?`Mostrando <b>${shown}</b> de ${tot} seções — filtro: <b>${esc(AC[S.acao].nome)}</b> · <button class="lkbtn" onclick="S.refall=true;render()">ver todas as seções</button>`
    :`Mostrando <b>todas as ${tot} seções</b> · <button class="lkbtn" onclick="S.refall=false;render()">voltar ao filtro ${esc(AC[S.acao].nome)}</button>`}</div>`:'';
  return `<div class="gmp info"><span class="ic">${ICO.info}</span><div class="tx">
    <b>Fonte oficial:</b> ${esc(e.manual)}. ${e.idioma==='EN'?'Manual original em inglês — traduções neste guia são livres, para consulta.':''}
    Índice completo, conforme o sumário de cada manual. Toque no documento para abrir a lista e em uma seção para ver a página — dali dá para folhear o documento inteiro com ‹ ›.</div></div>
  ${fbar}${groups}`;
}

