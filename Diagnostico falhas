/* ---------- EQUIPAMENTO ---------- */
function secsDe(eq, acao){
  const base=D.secoes.filter(s=>s.eqs.includes(eq));
  if(!acao) return base;
  const f=base.filter(s=>s.acoes.includes(acao));
  return f.length?f:base;
}
function tabsFor(id){
  const t=[];
  if(S.acao&&S.acao!=='diagnostico'&&S.acao!=='seguranca'){
    const n=nAcaoEq(S.acao,id); if(n) t.push(['proc',AC[S.acao].nome,n]);
  }else if(!S.acao){
    ['montagem','regulagem','partida','desmontagem','operacao','limpeza'].forEach(a=>{
      const n=nAcaoEq(a,id); if(n) t.push(['a_'+a,AC[a].nome,n]);});
  }
  if((!S.acao||S.acao==='seguranca')&&D.rapido.filter(r=>r.eq===id).length)
    t.push(['seg','Segurança',D.rapido.filter(r=>r.eq===id).length]);
  const nr=refCount(id);
  if(nr) t.push(['ref','Onde consultar',nr]);
  const nd=nAcaoEq('diagnostico',id);
  if(nd&&(!S.acao||S.acao==='diagnostico')) t.push(['diag','Diagnóstico de falhas',nd]);
  return t;
}
function viewEq(){
  const e=EQ[S.eq];const tabs=tabsFor(e.id);
  if(!tabs.find(t=>t[0]===S.tab)) S.tab=tabs[0][0];
  let body='';
  if(S.tab==='proc') body=paneProc(e,S.acao);
  else if(S.tab.startsWith('a_')) body=paneProc(e,S.tab.slice(2));
  else if(S.tab==='ref') body=paneRef(e);
  else if(S.tab==='diag') body=paneDiag(e);
  else if(S.tab==='seg') body=paneSeg(e);
  return `<div class="crumb"><button onclick="goHome()">Início</button><span class="sep">›</span>
    <button onclick="pickEq('${e.id}')">${esc(e.curto)}</button><span class="sep">›</span>
    <span><b>${S.acao?esc(AC[S.acao].nome):'Tudo'}</b></span></div>
  <h1>${esc(e.nome)}</h1><p class="lead">${esc(e.papel)}</p>
  <div class="tabs">${tabs.map(([k,l,c])=>`<button class="tab ${S.tab===k?'on':''}" onclick="setTab('${k}')">${esc(l)}<span class="cnt">${c}</span></button>`).join('')}</div>
  ${body}`;
}

/* ---------- aba: procedimentos ---------- */
function paneProc(e,acao){
  const ps=procsDe(acao,e.id);
  const lim=(acao==='limpeza'&&e.id==='mg2')?D.limpeza:[];
  const seg=(acao==='seguranca')?D.rapido.filter(r=>r.eq===e.id):[];

  const nlac=ps.reduce((s,p)=>s+p.passos.filter(x=>x.lacuna).length,0);
  let h='';
  if(nlac) h+=`<div class="gmp"><span class="ic">${ICO.warn}</span><div class="tx">
    <b>${nlac} passos deste conjunto são ilustrados por figura no manual.</b> Toque em <b>ver página ›</b> no passo
    para abrir, dentro do guia, a página correspondente do capítulo com a figura original.</div></div>`;
  h+=ps.map(p=>procCard(p)).join('');
  if(lim.length){
    h+=`<div class="sechead"><span class="n">Manual de manutenção</span><h2>Procedimentos de limpeza</h2></div>`;
    h+=lim.map(c=>limpCard(c)).join('');
  }
  if(seg.length){
    h+=`<div class="qgrid">${seg.map(r=>`<button class="qcard" onclick="goRef('${r.eq}','${encodeURIComponent(r.tema)}')">
      <span class="qic">${ICO[r.ico]}</span><span class="qtx"><span class="qn">${esc(r.rot)}</span>
      <span class="qs">${esc(r.cap)} ${esc(r.sec)}</span></span></button>`).join('')}</div>`;
  }
  return h||`<div class="empty"><div class="big">Sem procedimentos nesta combinação</div></div>`;
}
