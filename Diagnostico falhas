/* ---------- aba: onde consultar ---------- */
/* resolve a página inicial referenciada, se ela existir no guia */
function pgKeyRef(r){
  const d=r.doc||'',c=r.cap||'';let id=null;
  if(d.indexOf('Manual do Operador')===0){const m=c.match(/^Cap\.\s*(\d+)/);id=m?({2:'cap2',3:'cap3',4:'cap4',5:'cap5',6:'cap6',7:'cap7',8:'cap8',9:'cap9'})[+m[1]]||null:null;}
  else if(d.indexOf('6506_CMM013')===0)id='piab';
  else if(d.indexOf('6506_IML006')===0)id='det';
  else if(d.indexOf('6506_IML015')===0)id='iml15';
  else if(d.indexOf('6506_IML007')===0)id='iml7';
  else if(d.indexOf('Desmontagem do PIAB')===0)id='piabd';
  if(!id)return null;
  const pg=parseInt(r.pag,10);
  if(!pg||!D.paginas[id+'_'+pg])return null;
  return {id:id,pg:pg};
}
