function wrapT(s,n){const ws=s.split(' ');const o=[];let l='';
  ws.forEach(w=>{if((l+' '+w).trim().length>n){if(l)o.push(l);l=w;}else l=(l+' '+w).trim();});
  if(l)o.push(l);return o.slice(0,2);}
function flowSVG(){
  const st=D.etapas,w=138,h=92,gap=24,y=34;let x=14,bx='',ar='';
  st.forEach((e,i)=>{
    const eqs=D.equipamentos.filter(q=>q.etapa===e.id).map(q=>q.curto).join(' · ');
    bx+=`<g class="st-hit" onclick="pickEq('${D.equipamentos.find(q=>q.etapa===e.id).id}')" role="button" tabindex="0">
