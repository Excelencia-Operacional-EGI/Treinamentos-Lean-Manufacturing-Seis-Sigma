<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
<title>Muri, Mura e Muda — Biolab & CO.</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet"/>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --navy:      #08132a;
    --blue-corp: #0d47a1;
    --blue-mid:  #1565c0;
    --cyan:      #00c8d7;
    --cyan-soft: #b2ebf2;
    --green:     #2e7d32;
    --green-soft:#e8f5e9;
    --amber:     #e65100;
    --amber-soft:#fff3e0;
    --red:       #c62828;
    --red-soft:  #ffebee;
    --white:     #ffffff;
    --off:       #f7f9fc;
    --gray-100:  #f0f2f5;
    --gray-200:  #e2e8f0;
    --gray-400:  #94a3b8;
    --gray-600:  #64748b;
    --gray-800:  #1e293b;
    --font-body: 'Plus Jakarta Sans', sans-serif;
    --font-title:'Syne', sans-serif;
    --radius:    16px;
    --shadow:    0 4px 24px rgba(13,71,161,.10);
    --shadow-lg: 0 8px 40px rgba(13,71,161,.18);
  }

  html { scroll-behavior: smooth; -webkit-print-color-adjust: exact; print-color-adjust: exact; }

  body {
    font-family: var(--font-body);
    background: var(--white);
    color: var(--gray-800);
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  /* ── ANIMATIONS ── */
  @keyframes fadeDown { from{opacity:0;transform:translateY(-14px);}to{opacity:1;transform:translateY(0);} }
  @keyframes fadeUp   { from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);} }
  @keyframes blink    { 0%,100%{opacity:1;}50%{opacity:.4;transform:scale(.7);} }
  @keyframes spinRing { to{transform:rotate(360deg);} }
  @keyframes popIn    { 0%{transform:scale(.5);opacity:0;}70%{transform:scale(1.1);}100%{transform:scale(1);opacity:1;} }
  @keyframes pulse    { 0%,100%{box-shadow:0 0 0 0 rgba(0,200,215,.5);}70%{box-shadow:0 0 0 10px rgba(0,200,215,0);} }
  @keyframes shimmer  { from{background-position:200% 0;}to{background-position:-200% 0;} }
  @keyframes floatUp  { 0%,100%{transform:translateY(0);}50%{transform:translateY(-8px);} }
  @keyframes barGrow  { from{width:0;}to{width:var(--w);} }
  @keyframes countUp  { from{opacity:0;transform:scale(.8);}to{opacity:1;transform:scale(1);} }

  /* ── COVER ── */
  .cover {
    min-height: 100svh;
    background: var(--navy);
    display: flex; flex-direction: column; justify-content: center; align-items: center;
    text-align: center;
    padding: clamp(24px,6vw,60px) clamp(20px,5vw,40px);
    position: relative; overflow: hidden;
  }

  .cover::before {
    content:'';
    position:absolute; inset:0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 30%, rgba(13,71,161,.5) 0%, transparent 60%),
      radial-gradient(ellipse 60% 50% at 80% 70%, rgba(0,200,215,.18) 0%, transparent 55%);
    pointer-events:none;
  }

  .cover-grid {
    position:absolute; inset:0;
    background-image: repeating-linear-gradient(
      -45deg,
      rgba(255,255,255,.025) 0px,
      rgba(255,255,255,.025) 1px,
      transparent 1px,
      transparent 40px
    );
    pointer-events:none;
  }

  .cover-ghost {
    position:absolute;
    font-family: var(--font-title);
    font-size: clamp(80px,22vw,220px);
    font-weight:800;
    color: rgba(255,255,255,.025);
    letter-spacing:-.02em;
    white-space:nowrap;
    top:50%; transform:translateY(-50%);
    pointer-events:none;
    user-select:none;
  }

  .cover-inner { position:relative; z-index:2; }

  .cover-badge {
    display:inline-flex; align-items:center; gap:8px;
    border: 1px solid rgba(0,200,215,.35);
    border-radius:100px;
    padding: 6px 16px;
    font-size: clamp(10px,.9rem,12px);
    font-weight:600;
    color: var(--cyan);
    letter-spacing:.1em;
    text-transform:uppercase;
    margin-bottom: clamp(16px,4vw,28px);
    animation: fadeDown .7s ease both;
    background: rgba(0,200,215,.08);
  }

  .badge-dot {
    width:7px; height:7px;
    border-radius:50%;
    background:var(--cyan);
    animation: blink 1.6s ease-in-out infinite;
  }

  .cover-eyebrow {
    font-size: clamp(11px,.75rem,13px);
    font-family: var(--font-title);
    font-weight:700;
    color: rgba(255,255,255,.45);
    letter-spacing:.18em;
    text-transform:uppercase;
    margin-bottom: clamp(10px,2vw,14px);
    animation: fadeDown .8s .1s ease both;
  }

  .cover-title {
    font-family: var(--font-title);
    font-size: clamp(38px,9vw,80px);
    font-weight:800;
    line-height:1.05;
    letter-spacing:-.03em;
    background: linear-gradient(135deg, #ffffff 0%, var(--cyan) 60%, #7fffd4 100%);
    -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text;
    animation: fadeUp .8s .2s ease both;
    margin-bottom: clamp(6px,1.5vw,12px);
  }

  .cover-divider {
    width: clamp(40px,8vw,60px);
    height:3px;
    background: linear-gradient(90deg, var(--cyan), transparent);
    border-radius:99px;
    margin: clamp(14px,3vw,22px) auto;
    animation: fadeUp .8s .3s ease both;
  }

  .cover-sub {
    font-size: clamp(13px,1.1rem,17px);
    color: rgba(255,255,255,.65);
    max-width:520px;
    line-height:1.7;
    animation: fadeUp .8s .35s ease both;
    margin-bottom: clamp(28px,6vw,48px);
  }

  .cover-stats {
    display:flex; justify-content:center; flex-wrap:wrap; gap:clamp(16px,4vw,32px);
    animation: fadeUp .8s .45s ease both;
    margin-bottom: clamp(32px,7vw,56px);
  }

  .stat-item { text-align:center; }
  .stat-num {
    font-family: var(--font-title);
    font-size: clamp(26px,5vw,42px);
    font-weight:800;
    color: var(--white);
    display:block; line-height:1;
  }
  .stat-label {
    font-size: clamp(10px,.7rem,12px);
    color: rgba(255,255,255,.45);
    text-transform:uppercase;
    letter-spacing:.1em;
    font-weight:600;
  }
  .stat-sep { color:rgba(255,255,255,.15); font-size:clamp(20px,3vw,28px); align-self:center; }

  .cover-footer {
    position:absolute; bottom: clamp(16px,4vw,28px); left:0; right:0;
    text-align:center;
    font-size: clamp(10px,.7rem,12px);
    color:rgba(255,255,255,.25);
    letter-spacing:.08em;
    animation: fadeUp .8s .6s ease both;
  }

  .scroll-hint {
    display:flex; flex-direction:column; align-items:center; gap:6px;
    color:rgba(255,255,255,.35);
    font-size:11px; letter-spacing:.1em; text-transform:uppercase;
    animation: floatUp 2.4s ease-in-out infinite;
  }
  .scroll-arrow { font-size:18px; }

  /* ── SECTION WRAPPER ── */
  .content-section {
    padding: clamp(40px,8vw,80px) clamp(20px,5vw,40px);
    max-width: 760px; margin:0 auto;
  }

  .section-alt { background: var(--off); }

  .module-label {
    display:inline-block;
    font-size: clamp(10px,.7rem,12px);
    font-family: var(--font-title);
    font-weight:700;
    color: var(--blue-corp);
    letter-spacing:.18em;
    text-transform:uppercase;
    border-left:3px solid var(--cyan);
    padding-left:10px;
    margin-bottom: clamp(10px,2vw,16px);
  }

  .section-title {
    font-family: var(--font-title);
    font-size: clamp(22px,4vw,36px);
    font-weight:800;
    line-height:1.2;
    color: var(--navy);
    margin-bottom: clamp(14px,3vw,22px);
  }

  .body-text {
    font-size: clamp(14px,1rem,16px);
    line-height:1.82;
    color: var(--gray-600);
    margin-bottom: clamp(12px,2.5vw,18px);
  }
  .body-text strong { color: var(--gray-800); font-weight:600; }

  /* ── CARDS ── */
  .card-grid {
    display:grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(10px,2.5vw,16px);
    margin: clamp(20px,4vw,32px) 0;
  }

  .card {
    background: var(--white);
    border-radius: var(--radius);
    padding: clamp(16px,3.5vw,24px);
    box-shadow: var(--shadow);
    transition: transform .18s, box-shadow .18s;
    border: 1px solid var(--gray-200);
  }

  .card:active { transform:scale(.97); }

  .card-icon { font-size: clamp(24px,5vw,32px); margin-bottom:10px; display:block; }
  .card-title {
    font-family: var(--font-title);
    font-size: clamp(13px,.95rem,15px);
    font-weight:700;
    color: var(--navy);
    margin-bottom:6px;
  }
  .card-text {
    font-size: clamp(11px,.8rem,13px);
    color: var(--gray-600);
    line-height:1.6;
  }

  /* colored top bar */
  .card-bar { border-top: 4px solid var(--bar-color, var(--blue-corp)); }
  .bar-navy   { --bar-color: var(--navy); }
  .bar-cyan   { --bar-color: var(--cyan); }
  .bar-amber  { --bar-color: var(--amber); }
  .bar-green  { --bar-color: var(--green); }
  .bar-red    { --bar-color: var(--red); }

  /* border-left */
  .card-left {
    border-left: 4px solid var(--left-color, var(--cyan));
    border-radius: 0 var(--radius) var(--radius) 0;
    padding-left: clamp(16px,4vw,24px);
  }
  .left-cyan   { --left-color: var(--cyan); }
  .left-amber  { --left-color: var(--amber); }
  .left-green  { --left-color: var(--green); }
  .left-navy   { --left-color: var(--navy); }
  .left-red    { --left-color: var(--red); }

  /* ── DOMINO TABLE ── */
  .domino-table {
    width:100%;
    border-radius: var(--radius);
    overflow:hidden;
    box-shadow: var(--shadow);
    margin: clamp(20px,4vw,32px) 0;
    border:1px solid var(--gray-200);
  }

  .domino-head {
    display:grid; grid-template-columns:1fr 1fr 1fr 1fr;
    background: var(--navy);
    padding: 10px 0;
  }

  .domino-head-cell {
    font-family: var(--font-title);
    font-size: clamp(10px,.7rem,11px);
    font-weight:700;
    color: rgba(255,255,255,.7);
    text-align:center;
    letter-spacing:.1em;
    text-transform:uppercase;
    padding: 6px 8px;
  }

  .domino-row {
    display:grid; grid-template-columns:1fr 1fr 1fr 1fr;
    border-bottom:1px solid var(--gray-100);
  }
  .domino-row:last-child { border-bottom:none; }
  .domino-row:nth-child(even) { background: var(--off); }

  .domino-cell {
    font-size: clamp(11px,.78rem,13px);
    color: var(--gray-600);
    padding: clamp(12px,2.5vw,16px) clamp(8px,2vw,14px);
    line-height:1.55;
    vertical-align:top;
  }

  .domino-cell.concept {
    font-family: var(--font-title);
    font-weight:700;
    font-size: clamp(12px,.85rem,15px);
    color: var(--navy);
    border-left:4px solid var(--row-color);
  }

  .row-muri { --row-color: var(--amber); }
  .row-mura { --row-color: var(--blue-corp); }
  .row-muda { --row-color: var(--green); }

  .concept-tag {
    display:inline-block;
    font-size: clamp(9px,.65rem,11px);
    font-weight:700;
    padding:2px 8px;
    border-radius:99px;
    margin-bottom:4px;
  }
  .tag-amber { background:var(--amber-soft); color:var(--amber); }
  .tag-blue  { background:#e3f2fd; color:var(--blue-corp); }
  .tag-green { background:var(--green-soft); color:var(--green); }

  /* ── TIMELINE ── */
  .timeline {
    display:flex; flex-direction:column; gap:0;
    margin: clamp(20px,4vw,32px) 0;
    position:relative;
  }

  .timeline-item {
    display:flex; gap: clamp(14px,3vw,20px);
    position:relative;
  }

  .timeline-left {
    display:flex; flex-direction:column; align-items:center;
    flex-shrink:0; width:36px;
  }

  .timeline-num {
    width:36px; height:36px;
    border-radius:50%;
    background: var(--navy);
    color:var(--white);
    font-family: var(--font-title);
    font-weight:800;
    font-size:15px;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
    position:relative; z-index:1;
  }

  .timeline-line {
    flex:1; width:2px;
    background: linear-gradient(to bottom, var(--navy), rgba(13,71,161,.1));
    margin:4px 0;
    min-height:32px;
  }

  .timeline-item:last-child .timeline-line { display:none; }

  .timeline-body {
    padding-bottom: clamp(20px,4vw,28px);
    flex:1;
  }

  .timeline-title {
    font-family: var(--font-title);
    font-weight:700;
    font-size: clamp(14px,1rem,17px);
    color: var(--navy);
    margin-bottom:6px;
    margin-top:6px;
  }

  .timeline-text {
    font-size: clamp(12px,.85rem,14px);
    color: var(--gray-600);
    line-height:1.65;
  }

  .timeline-tip {
    margin-top:8px;
    background:var(--cyan-soft);
    border-radius:10px;
    padding:10px 14px;
    font-size: clamp(11px,.78rem,13px);
    color: #006064;
    font-weight:500;
  }

  /* ── INFO BOX ── */
  .info-box {
    background: linear-gradient(135deg, #e3f2fd 0%, #e8f5e9 100%);
    border-radius: var(--radius);
    padding: clamp(18px,4vw,28px);
    margin: clamp(16px,3.5vw,26px) 0;
    border:1px solid rgba(13,71,161,.12);
  }

  .info-box-title {
    font-family: var(--font-title);
    font-weight:700;
    font-size: clamp(13px,.9rem,16px);
    color: var(--navy);
    margin-bottom:12px;
    display:flex; align-items:center; gap:8px;
  }

  .info-list { list-style:none; display:flex; flex-direction:column; gap:10px; }
  .info-list li {
    font-size: clamp(12px,.85rem,14px);
    color: var(--gray-700);
    line-height:1.6;
    display:flex; gap:10px; align-items:flex-start;
  }
  .info-list li::before {
    content:'→';
    color:var(--cyan);
    font-weight:700;
    flex-shrink:0;
    margin-top:1px;
  }

  /* ── BLOCKQUOTE ── */
  .blockquote {
    background: linear-gradient(135deg, var(--navy) 0%, var(--blue-mid) 100%);
    border-radius: var(--radius);
    padding: clamp(22px,5vw,36px);
    margin: clamp(20px,4vw,32px) 0;
    text-align:center;
    position:relative;
    overflow:hidden;
  }

  .blockquote::before {
    content:'"';
    position:absolute; top:-10px; left:16px;
    font-family: var(--font-title);
    font-size:100px; font-weight:800;
    color:rgba(255,255,255,.08);
    line-height:1;
  }

  .blockquote-text {
    font-family: var(--font-title);
    font-size: clamp(16px,2.2rem,24px);
    font-weight:700;
    color:var(--white);
    line-height:1.4;
    position:relative;
  }

  .blockquote-author {
    margin-top:12px;
    font-size: clamp(11px,.75rem,13px);
    color:rgba(255,255,255,.5);
    font-weight:500;
    letter-spacing:.08em;
  }

  /* ── EFFECT FLOW ── */
  .effect-flow {
    display:flex; flex-direction:column; gap:0;
    margin: clamp(20px,4vw,32px) 0;
  }

  .effect-node {
    display:flex; align-items:flex-start; gap:14px;
    padding: clamp(16px,3.5vw,22px);
    border-radius: var(--radius);
    background:var(--white);
    box-shadow:var(--shadow);
    border:1px solid var(--gray-200);
    transition:transform .15s;
  }
  .effect-node:active { transform:scale(.98); }

  .effect-arrow {
    text-align:center;
    font-size:22px;
    color:var(--gray-400);
    padding:6px 0;
  }

  .effect-emoji { font-size:28px; flex-shrink:0; margin-top:2px; }
  .effect-content {}
  .effect-tag {
    font-size:10px; font-weight:700;
    letter-spacing:.12em; text-transform:uppercase;
    margin-bottom:4px; display:block;
  }
  .effect-title {
    font-family: var(--font-title);
    font-weight:700;
    font-size: clamp(14px,1rem,16px);
    color: var(--navy);
    margin-bottom:4px;
  }
  .effect-desc {
    font-size: clamp(11px,.78rem,13px);
    color: var(--gray-600);
    line-height:1.6;
  }

  /* ── TOOL CARDS ── */
  .tool-section { margin: clamp(20px,4vw,30px) 0; }
  .tool-header {
    display:flex; align-items:center; gap:10px;
    padding: 10px 16px;
    border-radius:10px 10px 0 0;
    font-family: var(--font-title);
    font-weight:700;
    font-size: clamp(13px,.9rem,15px);
    color:var(--white);
  }
  .tool-header.amber-bg { background: var(--amber); }
  .tool-header.blue-bg  { background: var(--blue-corp); }
  .tool-header.green-bg { background: var(--green); }

  .tool-items {
    border:1px solid var(--gray-200);
    border-radius:0 0 10px 10px;
    overflow:hidden;
  }
  .tool-item {
    display:flex; gap:12px; align-items:flex-start;
    padding: clamp(14px,3vw,18px) clamp(14px,3vw,18px);
    border-bottom:1px solid var(--gray-100);
    background:var(--white);
  }
  .tool-item:last-child { border-bottom:none; }
  .tool-item-icon { font-size:22px; flex-shrink:0; }
  .tool-item-name {
    font-weight:600;
    font-size: clamp(13px,.9rem,15px);
    color: var(--navy);
    margin-bottom:3px;
  }
  .tool-item-desc {
    font-size: clamp(11px,.78rem,13px);
    color: var(--gray-600);
    line-height:1.55;
  }

  /* ── QUIZ ── */
  .quiz-section {
    padding: clamp(32px,6vw,64px) clamp(20px,5vw,40px);
    max-width: 760px; margin:0 auto;
  }

  .quiz-header { text-align:center; margin-bottom: clamp(24px,5vw,40px); }

  .quiz-label {
    display:inline-block;
    font-size: clamp(10px,.7rem,12px);
    font-family: var(--font-title);
    font-weight:700;
    color: var(--blue-corp);
    letter-spacing:.18em;
    text-transform:uppercase;
    border-left:3px solid var(--cyan);
    padding-left:10px;
    margin-bottom: clamp(10px,2vw,16px);
  }

  .quiz-title {
    font-family: var(--font-title);
    font-size: clamp(22px,4vw,34px);
    font-weight:800;
    color: var(--navy);
    margin-bottom: 10px;
  }

  .quiz-instruction {
    font-size: clamp(13px,.9rem,15px);
    color: var(--gray-600);
  }

  .progress-wrap {
    margin-bottom: clamp(20px,4vw,30px);
  }

  .progress-top {
    display:flex; justify-content:space-between; align-items:center;
    margin-bottom:8px;
    font-size: clamp(11px,.78rem,13px);
    color: var(--gray-600);
    font-weight:600;
  }

  .progress-bar-bg {
    height:8px;
    background: var(--gray-200);
    border-radius:99px;
    overflow:hidden;
  }

  .progress-bar-fill {
    height:100%;
    background: linear-gradient(90deg, var(--blue-corp), var(--cyan));
    border-radius:99px;
    transition: width .5s cubic-bezier(.4,0,.2,1);
    width: 0%;
  }

  .question-card {
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    padding: clamp(20px,4.5vw,32px);
    border:1px solid var(--gray-200);
    animation: fadeUp .4s ease;
  }

  .q-num {
    font-size: clamp(10px,.7rem,12px);
    font-family: var(--font-title);
    font-weight:700;
    color: var(--gray-400);
    letter-spacing:.12em;
    text-transform:uppercase;
    margin-bottom:10px;
  }

  .q-text {
    font-family: var(--font-title);
    font-weight:700;
    font-size: clamp(15px,1.1rem,19px);
    color: var(--navy);
    line-height:1.4;
    margin-bottom: clamp(16px,3.5vw,24px);
  }

  .options { display:flex; flex-direction:column; gap:10px; }

  .option {
    display:flex; align-items:flex-start; gap:12px;
    background: var(--off);
    border:2px solid var(--gray-200);
    border-radius:12px;
    padding: clamp(12px,2.5vw,16px);
    cursor:pointer;
    transition:border-color .15s, background .15s, transform .1s;
    font-size: clamp(13px,.9rem,15px);
    color: var(--gray-800);
    line-height:1.5;
    -webkit-tap-highlight-color:transparent;
    text-align:left;
  }
  .option:active { transform:scale(.98); }
