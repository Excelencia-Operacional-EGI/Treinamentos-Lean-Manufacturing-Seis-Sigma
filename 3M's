      "Nenhum — é apenas uma questão de priorização"
    ],
    correct: 2,
    feedback: "Correto! Forçar uma equipe a entregar 2,5× sua capacidade normal é Muri clássico — sobrecarga. O resultado previsível: qualidade comprometida, erros, atrasos e burnout. A resposta adequada é renegociar prazos ou redistribuir o escopo, não simplesmente aceitar o Muri."
  },
  {
    q: "Qual é a principal diferença entre atacar o Muda diretamente versus corrigir o Mura primeiro?",
    opts: [
      "Não há diferença — todas as abordagens têm o mesmo resultado",
      "Atacar o Muda é mais rápido; corrigir o Mura é mais completo mas demorado",
      "Atacar o Muda trata o sintoma; corrigir o Mura ataca a causa raiz que gera o Muri e o Muda",
      "O Muda deve sempre ser eliminado antes de qualquer outra ação"
    ],
    correct: 2,
    feedback: "Excelente compreensão! Cortar desperdício sem resolver a inconsistência no fluxo é como esvaziar um balde furado — o problema retorna. Ao corrigir o Mura (fluxo regular), reduz-se automaticamente o Muri (menos picos de sobrecarga) e, consequentemente, o Muda (menos erros e retrabalho)."
  },
  {
    q: "Uma empresa de saúde percebe que seus profissionais estão usando equipamentos inadequados que os obrigam a repetir procedimentos com mais esforço físico. Para combater o Muri, qual ação é mais indicada?",
    opts: [
      "Contratar mais profissionais para dividir a carga",
      "Investir em ergonomia e adequação das ferramentas de trabalho",
      "Eliminar reuniões desnecessárias para liberar tempo",
      "Mapear o fluxo de valor para identificar gargalos"
    ],
    correct: 1,
    feedback: "Correto! Ferramentas inadequadas são uma forma de Muri — elas exigem esforço adicional dos profissionais para compensar a deficiência do equipamento. Investir em ergonomia e adequação das ferramentas é a ação direta para reduzir a sobrecarga e permitir que as pessoas trabalhem dentro de sua capacidade natural."
  },
  {
    q: "Ao final deste treinamento, qual deve ser o próximo passo concreto de cada participante na sua área de trabalho?",
    opts: [
      "Esperar que a liderança implemente as melhorias necessárias",
      "Compartilhar os conceitos apenas com o time imediato",
      "Observar o fluxo real de trabalho, identificar onde há Mura, Muri ou Muda, e propor uma melhoria concreta e mensurável",
      "Eliminar todas as reuniões e processos de aprovação existentes imediatamente"
    ],
    correct: 2,
    feedback: "Perfeito! O objetivo do treinamento não é apenas conhecer os termos — é engajar cada pessoa no processo de melhoria contínua. O passo prático é: observe, diagnostique e proponha. Uma melhoria pequena e real, implementada e medida, vale mais do que um plano perfeito nunca executado."
  }
];

let currentQ = 0;
let score = 0;
let answered = false;

function renderQuestion() {
  const q = questions[currentQ];
  const pct = Math.round((currentQ / questions.length) * 100);

  document.getElementById('prog-label').textContent = `Questão ${currentQ + 1} de ${questions.length}`;
  document.getElementById('prog-pct').textContent = pct + '%';
  document.getElementById('prog-bar').style.width = pct + '%';

  const isLast = currentQ === questions.length - 1;
  const letters = ['A','B','C','D'];

  const html = `
    <div class="question-card">
      <div class="q-num">Questão ${currentQ + 1} / ${questions.length}</div>
      <div class="q-text">${q.q}</div>
      <div class="options">
        ${q.opts.map((opt, i) => `
          <button class="option" onclick="answer(${i})" id="opt-${i}">
            <span class="opt-letter">${letters[i]}</span>
            ${opt}
          </button>
        `).join('')}
      </div>
      <div class="feedback-box" id="feedback"></div>
      <button class="btn-next" id="btn-next" onclick="${isLast ? 'finishQuiz()' : 'nextQuestion()'}">
        ${isLast ? 'Ver Resultado ✓' : 'Próxima questão →'}
      </button>
    </div>
  `;
  document.getElementById('question-container').innerHTML = html;
  answered = false;
}

function answer(idx) {
  if (answered) return;
  answered = true;

  const q = questions[currentQ];
  const opts = document.querySelectorAll('.option');
  const feedback = document.getElementById('feedback');
  const btnNext = document.getElementById('btn-next');

  opts.forEach((btn, i) => {
    btn.disabled = true;
    if (i === q.correct) btn.classList.add('correct');
    if (i === idx && idx !== q.correct) btn.classList.add('wrong');
  });

  if (idx === q.correct) {
    score++;
    feedback.className = 'feedback-box show fb-correct';
    feedback.innerHTML = `<strong>✅ Correto!</strong>${q.feedback}`;
  } else {
    feedback.className = 'feedback-box show fb-wrong';
    feedback.innerHTML = `<strong>❌ Não exatamente.</strong>${q.feedback}`;
  }

  btnNext.classList.add('show');
}

function nextQuestion() {
  currentQ++;
  renderQuestion();
  setTimeout(() => {
    const el = document.getElementById('quiz-section');
    el && el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 80);
}

function finishQuiz() {
  // update progress bar to 100%
  document.getElementById('prog-bar').style.width = '100%';
  document.getElementById('prog-pct').textContent = '100%';

  const conclusion = document.getElementById('conclusion');
  conclusion.classList.add('show');
  setTimeout(() => {
    conclusion.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 120);

  setupConclusion();
  launchConfetti();
}

function setupConclusion() {
  const s = score;
  const t = questions.length;

  // emoji
  let emoji, title, msg, badges;
  if (s === t) {
    emoji = '🥇';
    title = 'Pontuação Máxima!';
    msg = 'Parabéns! Você demonstrou domínio completo dos conceitos de Muri, Mura e Muda. Você está pronto para liderar iniciativas de melhoria contínua na sua área.';
    badges = [
      { label: 'Mestre Lean', color: '#ffd700' },
      { label: 'Pontuação Perfeita', color: '#00c8d7' },
      { label: 'Pronto para Liderar', color: '#2e7d32' }
    ];
  } else if (s >= 8) {
    emoji = '🏆';
    title = 'Excelente Desempenho!';
    msg = 'Muito bem! Você compreendeu profundamente os 3Ms e suas inter-relações. Com esse nível de entendimento, você já pode identificar e propor melhorias concretas na sua área.';
    badges = [
      { label: 'Alto Desempenho', color: '#00c8d7' },
      { label: 'Agente de Melhoria', color: '#2e7d32' }
    ];
  } else if (s >= 6) {
    emoji = '👍';
    title = 'Bom Resultado!';
    msg = 'Você captou os conceitos principais! Recomendamos revisitar os módulos onde teve dificuldade para solidificar o entendimento e estar ainda mais preparado para propor melhorias.';
    badges = [
      { label: 'Em Evolução', color: '#0d47a1' },
      { label: 'Continue Aprendendo', color: '#e65100' }
    ];
  } else {
    emoji = '🔄';
    title = 'Continue Praticando!';
    msg = 'Os conceitos dos 3Ms podem ser desafiadores no início. Revise os módulos de conteúdo com calma e refaça o quiz. O aprendizado contínuo é em si uma prática Lean!';
    badges = [
      { label: 'Revisão Recomendada', color: '#e65100' }
    ];
  }

  document.getElementById('result-emoji').textContent = emoji;
  document.getElementById('result-title').textContent = title;
  document.getElementById('result-msg').textContent = msg;
  document.getElementById('score-label').textContent = `de ${t} acertos`;

  // Animated counter
  let displayed = 0;
  const target = s;
  const duration = 900;
  const startTime = performance.now();
  const el = document.getElementById('result-score');

  function tick(now) {
    const elapsed = now - startTime;
    const progress = Math.min(elapsed / duration, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    displayed = Math.round(eased * target);
    el.textContent = `${displayed}/${t}`;
    if (progress < 1) requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);

  // Badges
  const badgesEl = document.getElementById('badges-row');
  badgesEl.innerHTML = badges.map(b => `
    <div class="badge-chip">
      <span class="chip-dot" style="background:${b.color}"></span>
      ${b.label}
    </div>
  `).join('');
}

function resetQuiz() {
  currentQ = 0;
  score = 0;
  answered = false;
  document.getElementById('conclusion').classList.remove('show');
  document.getElementById('prog-bar').style.width = '0%';
  renderQuestion();
  setTimeout(() => {
    document.getElementById('quiz-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }, 100);
  stopConfetti();
}

// ── CONFETTI ──────────────────────────────────────────────
let confettiAnimId = null;
let particles = [];

function launchConfetti() {
  const canvas = document.getElementById('confetti-canvas');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;

  const colors = ['#00c8d7','#0d47a1','#e65100','#2e7d32','#ffffff','#ffd700','#08132a'];
  particles = [];

  for (let i = 0; i < 90; i++) {
    particles.push({
      x: Math.random() * canvas.width,
      y: Math.random() * -canvas.height,
      w: Math.random() * 10 + 5,
      h: Math.random() * 6 + 3,
      color: colors[Math.floor(Math.random() * colors.length)],
      angle: Math.random() * Math.PI * 2,
      spin: (Math.random() - .5) * .2,
      vx: (Math.random() - .5) * 3,
      vy: Math.random() * 4 + 2
    });
  }

  let frame = 0;
  function draw() {
    if (frame >= 220) { ctx.clearRect(0,0,canvas.width,canvas.height); return; }
    ctx.clearRect(0,0,canvas.width,canvas.height);
    particles.forEach(p => {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.angle);
      ctx.fillStyle = p.color;
      ctx.globalAlpha = Math.max(0, 1 - frame / 180);
      ctx.fillRect(-p.w/2, -p.h/2, p.w, p.h);
      ctx.restore();
      p.x += p.vx; p.y += p.vy; p.angle += p.spin;
    });
    frame++;
    confettiAnimId = requestAnimationFrame(draw);
  }
  draw();
}

function stopConfetti() {
  if (confettiAnimId) { cancelAnimationFrame(confettiAnimId); confettiAnimId = null; }
  const canvas = document.getElementById('confetti-canvas');
  canvas.getContext('2d').clearRect(0,0,canvas.width,canvas.height);
}

// ── INIT ──────────────────────────────────────────────────
renderQuestion();
</script>
